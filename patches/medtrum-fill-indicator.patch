+
+private struct PrimeButtonStyle: ButtonStyle {
+    enum Kind {
+        case primary
+        case secondary
+    }
+
+    let kind: Kind
+    @Environment(\.isEnabled) private var isEnabled
+    @Environment(\.colorScheme) private var colorScheme
+
+    func makeBody(configuration: Configuration) -> some View {
+        configuration.label
+            .font(.headline)
+            .frame(maxWidth: .infinity)
+            .frame(minHeight: 44)
+            .padding(.horizontal)
+            .foregroundStyle(foregroundColor)
+            .background(backgroundColor)
+            .overlay(
+                RoundedRectangle(cornerRadius: 10)
+                    .stroke(borderColor, lineWidth: kind == .secondary ? 1 : 0)
+            )
+            .clipShape(RoundedRectangle(cornerRadius: 10))
+            .opacity(configuration.isPressed ? 0.75 : 1)
+    }
+
+    private var backgroundColor: Color {
+        guard isEnabled else {
+            return Color(UIColor.systemGray4)
+        }
+
+        switch kind {
+        case .primary:
+            return Color(UIColor.systemBlue)
+        case .secondary:
+            return colorScheme == .dark ? Color(UIColor.systemGray5) : Color(UIColor.systemGray6)
+        }
+    }
+
+    private var foregroundColor: Color {
+        guard isEnabled else {
+            return colorScheme == .dark ? Color(UIColor.systemGray) : Color(UIColor.secondaryLabel)
+        }
+
+        switch kind {
+        case .primary:
+            return .white
+        case .secondary:
+            return colorScheme == .dark ? .white : Color(UIColor.label)
+        }
+    }
+
+    private var borderColor: Color {
+        guard kind == .secondary, isEnabled else {
+            return .clear
+        }
+
+        return colorScheme == .dark ? Color(UIColor.systemGray2) : Color(UIColor.systemGray3)
+    }
+}
