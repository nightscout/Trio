          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Representa el equivalente de glúcido para grasa y proteína, calculado utilizando el Método de Varsovia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
