        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Sensitivity changes from Temp Targets have a built-in minimum of 15%. Even very high Temp Targets cannot reduce insulin delivery below 15% of normal."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Sensitivity changes from Temp Targets have a built-in minimum of 15%. Even very high Temp Targets cannot reduce insulin delivery below 15% of normal."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các thay đổi độ nhạy từ Mục tiêu tạm thời có mức tối thiểu tích hợp là 15%. Ngay cả khi Mục tiêu tạm thời rất cao cũng không thể giảm lượng insulin xuống dưới 15% so với mức bình thường."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由臨時目標造成的敏感度變化有 15% 的內建下限。即使將臨時目標設得很高，也無法把胰島素輸送降到低於正常的 15%。"
          }
        }
      }
    },
