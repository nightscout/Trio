    "This adjusted ISF is temporary, will change with the next loop cycle, and should not be directly used as your profile ISF value." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Този коригиран ISF е временен, ще се промени със следващия loop цикъл и не бива да се използва директно като ISF стойност в профила ви."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
