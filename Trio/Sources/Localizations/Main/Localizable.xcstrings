          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå Bluetooth til"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte Bluetooth einschalten"
          }
        },
        "en" : {
