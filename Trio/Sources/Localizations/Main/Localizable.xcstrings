    "Configuration changes will take effect on the next glucose reading." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Промените в конфигурацията ще влязат в сила при следващото показание на глюкозата."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Změny v nastavení se projeví až při dalším načtení hodnoty glukózy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konfigurationsændringer vil træde i kraft ved næste glukoseaflæsning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
