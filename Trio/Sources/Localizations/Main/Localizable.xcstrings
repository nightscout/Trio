    "Disables SMBs if last two glucose values differ by more than this percent." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изключва SMB, ако последните две стойности на глюкозата се различават с повече от този процент."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zakáže SMB, pokud se poslední dvě hodnoty glykémie liší o více než toto procento."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deaktiverer SMB'er, hvis de sidste to glucoseværdier afviger med mere end denne procent."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deaktiviert SMBs, wenn sich die letzten beiden Glukosewerte um mehr als diesen Prozentsatz unterscheiden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deshabilita SMBs si los últimos dos valores de glucosa difieren en más de este porcentaje."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactiver les \"SMBs\" si l’écart entre les deux dernières mesures de glucose dépasse ce seuil en pourcentage."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Disables SMBs if last two glucose values differ by more than this percent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disabilita le PMI se gli ultimi due valori di glucosio differiscono di più di questa percentuale."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Disables SMBs if last two glucose values differ by more than this percent."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deaktiverer SMB hvis de to siste blodsukkerverdiene avviker med mer enn denne prosenten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schakelt SMBs uit als de laatste twee glucosewaarden meer verschillen dan dit procent."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyłącza SMB, jeśli ostatnie dwie wartości glikemii różnią się o więcej niż ten procent."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desabilita as SMBs se dois últimos valores de glicose diferem por mais desse porcento."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Disables SMBs if last two glucose values differ by more than this percent."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Disables SMBs if last two glucose values differ by more than this percent."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inaktiverar SMB om de två senaste glukosvärdena skiljer sig mer än denna procent."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Disables SMBs if last two glucose values differ by more than this percent."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вимикає SMB, якщо останні два значення глюкози відрізняються більше цього відсотка."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vô hiệu hóa SMB nếu hai giá trị đường huyết gần nhất chênh lệch nhau quá tỷ lệ phần trăm này."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果最後兩個血糖值的差異超過此百分比，則停用微量注射 (SMB)。"
          }
        }
      }
    },
    "Disabling this setting will still allow other commands, like Temp Targets, Add Carbs, and Start/End Overrides" : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изключването на тази настройка пак ще позволява други команди, като Временни цели, Добавяне на въглехидрати и Стартиране/Прекратяване на отмени"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vypnutí tohoto nastavení stále umožní ostatní příkazy, jako jsou dočasné cíle, přidání sacharidů a spuštění/ukončení přepsání"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deaktivering af denne indstilling vil stadig tillade andre kommandoer, såsom Temp Targets, Tilføj kulhydrater og Start/End Overskrivninger"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deaktivieren dieser Einstellung erlaubt immer noch andere Befehle, wie Temporäre Ziele, Kohlenhydrate hinzufügen und Starte/Beende Overrides"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deshabilitar esta opción permitirá otros comandos, como Objetivos Temporales, Añadir Carbohidratos y Soberanos de Inicio / Final"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactiver ce réglage n’empêchera pas les autres commandes, comme les Cibles Temporaires, l’ajout de glucides ou le démarrage/l’arrêt d’une Dérogation"
          }
        },
        "he" : {
          "stringUnit" : {
