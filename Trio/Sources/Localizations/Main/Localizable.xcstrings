          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Trio will always display values based on your actual (raw) CGM readings. Smoothing does not change your real values or alerts."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio sẽ luôn hiển thị các giá trị dựa trên dữ liệu CGM thực tế (raw) của bạn. Việc làm mượt không làm thay đổi giá trị thực hoặc các cảnh báo của bạn."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio 將一律以你的實際（原始）CGM 讀值為準進行顯示。平滑化不會更改你的實際數值或警示。"
          }
        }
      }
    },
    "Trio will automatically assign a name like 'Trio 1' to any contact image you add, and a create an entry under your iOS Contacts. Use the 'Save' button at the bottom to save your customized contact image." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio автоматично ще присвои име като „Trio 1“ на всяко добавено от вас изображение за контакт и ще създаде запис във вашите Контакти в iOS. Използвайте бутона „Запис“ в долната част, за да запазите персонализираното изображение за контакт."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio automaticky přiřadí název jako „Trio 1“ ke každému obrázku kontaktu, který přidáš, a vytvoří záznam ve tvých kontaktech v iOS. Pro uložení vlastního obrázku kontaktu použij tlačítko „Uložit“ v dolní části obrazovky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio vil automatisk tildele et navn som 'Trio 1' til ethvert kontaktbillede, du tilføjer, og en opret en post under dine iOS Kontakter. Brug knappen 'Gem' i bunden for at gemme dit tilpassede kontaktbillede."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio weist jedem Kontaktbild, das Du hinzufügst, automatisch einen Namen wie \"Trio 1\" zu und erstellt einen Eintrag unter Deinen iOS-Kontakten. Verwende die Schaltfläche \"Speichern\" am unteren Rand, um Dein angepasstes Kontaktbild zu speichern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio asignará automáticamente un nombre como 'Trio 1' a cualquier imagen de contacto que añada, y creará una entrada bajo tus contactos iOS. Utilice el botón 'Guardar' en la parte inferior para guardar su imagen de contacto personalizada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio attribuera automatiquement un nom tel que \"Trio 1\" à toute image de contact que vous ajoutez, et créera une fiche dans vos Contacts iOS. Touchez le bouton \"Enregistrer\" en bas pour sauvegarder votre image de contact personnalisée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Trio will automatically assign a name like 'Trio 1' to any contact image you add, and a create an entry under your iOS Contacts. Use the 'Save' button at the bottom to save your customized contact image."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio assegnerà automaticamente un nome come 'Trio 1' a qualsiasi immagine di contatto che aggiungi, e una creazione di una voce sotto i tuoi contatti iOS. Usa il pulsante 'Salva' in basso per salvare l'immagine di contatto personalizzata."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Trio will automatically assign a name like 'Trio 1' to any contact image you add, and a create an entry under your iOS Contacts. Use the 'Save' button at the bottom to save your customized contact image."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio vil automatisk tilordne et navn som 'Trio 1' til ethvert kontaktbilde du legger til, og opprette en oppføring under iOS-kontaktene. Bruk 'Lagre'-knappen nederst for å lagre ditt tilpassede kontaktbilde."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio zal automatisch een naam zoals 'Trio 1' toewijzen aan elke contactpersoon die u toevoegt, en maak een item aan onder uw iOS-contactpersonen. Gebruik de 'Opslaan' knop onderaan om uw aangepaste contact afbeelding op te slaan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio automatycznie przypisze nazwę jak 'Trio 1' do każdego dodanego obrazu kontaktu i utworzy wpis w ramach kontaktów iOS. Użyj przycisku 'Zapisz' na dole, aby zapisać swój niestandardowy obraz kontaktu."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio atribuirá automaticamente um nome como 'Trio 1' a qualquer imagem de contato que você adicionar e uma entrada sob seus Contatos iOS. Use o botão 'Salvar' na parte inferior para salvar sua imagem personalizada de contato."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Trio will automatically assign a name like 'Trio 1' to any contact image you add, and a create an entry under your iOS Contacts. Use the 'Save' button at the bottom to save your customized contact image."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Трио автоматически назначит имя типа «Трио 1» на любое изображение контакта, которое вы добавили и создаст запись в ваших контактах iOS. Используйте кнопку «Сохранить» внизу для сохранения настроенного изображения контакта."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio kommer automatiskt att tilldela ett namn som \"Trio 1\" till de kontaktbilder du lägger till, och skapar en post under dina iOS-kontakter. Använd knappen \"Spara\" längst ner för att spara din anpassade kontaktbild."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Trio will automatically assign a name like 'Trio 1' to any contact image you add, and a create an entry under your iOS Contacts. Use the 'Save' button at the bottom to save your customized contact image."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тріо автоматично приведе до назви типу «Trio 1» на будь-яке зображення, що ви додаєте, і створить запис у ваших iOS контактах. Використовуйте кнопку \"Зберегти\" внизу для збереження індивідуального зображення контактів."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio sẽ lưu hình liên hệ kèm tên mặc định (ví dụ: “Trio 1”) vào Danh bạ iOS. Nhấn “Lưu” để hoàn tất.."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio 將自動為您新增的任何聯絡人圖像分配類似 'Trio 1' 的名稱，並在您的 iOS 聯絡人中創建一個條目。使用底部的 '儲存' 按鈕來保存您的自訂聯絡人圖像。"
          }
        }
      }
    },
