    "Tracks the carbohydrates you eat, entered to guide insulin dosing." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проследява въглехидратите, които ядете, въведени за насочване на дозирането на инсулина."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleduje zadané sacharidy, které slouží k určení dávkování inzulínu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Måler de kulhydrater, De spiser, og som kan vejlede insulindosis."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verfolgt die von Dir gegessenen Kohlenhydrate, die zur Steuerung der Insulindosierung eingegeben werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seguir los hidratos de carbono que usted come, entró para guiar la dosis de insulina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signale les glucides que vous avez consommés et enregistrés, pour servir de base au dosage d’insuline."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Tracks the carbohydrates you eat, entered to guide insulin dosing."
          }
        },
        "it" : {
          "stringUnit" : {
