          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio kan automatisk tilpasse insulintilførsel basert på inndata og blodsukkerprognose. Algoritme-innstillingene dine spiller en viktig rolle for nøyaktig og effektiv dosering."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio kan automatisch insuline levering aanpassen op basis van input en glucosevoorspellingen. Jouw algoritmeinstellingen spelen een belangrijke rol in nauwkeurige en effectieve dosis."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio może automatycznie dostosowywać podawanie insuliny na podstawie danych wejściowych i prognoz glikemii. Twoje ustawienia algorytmu odgrywają główną rolę w dokładnym i skutecznym dawkowaniu."
          }
        },
        "pt-PT" : {
