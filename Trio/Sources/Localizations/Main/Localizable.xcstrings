    "Forecasts future glucose levels and insulin dosing needs for unexpected meals or other causes of glucose reading increases without prior notice." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прогнозира бъдещите нива на глюкозата и нуждите от дозиране на инсулин за неочаквани хранения или други причини за необявено покачване на показанията."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Předpovídá budoucí hladiny glukózy a potřebu inzulínu pro nečekaná jídla nebo jiné příčiny náhlého vzestupu glukózy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prognoser fremtidige glukoseniveauer og insulindosis behøver uventede måltider eller andre årsager til glukoselæsning uden forudgående varsel."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prognostiziert zukünftige Glukosewerte und Insulinbedarf bei unerwarteten Mahlzeiten oder anderen Ursachen für einen unangekündigten Anstieg der Glukosewerte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Predicción de futuros niveles de glucosa y necesidades de dosis de insulina para comidas inesperadas u otras causas de lectura de glucosa aumenta sin previo aviso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prévision des niveaux du taux de glucose et des besoins en insuline en cas de repas non annoncés ou d’autres hausses de glucose imprévues."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Forecasts future glucose levels and insulin dosing needs for unexpected meals or other causes of glucose reading increases without prior notice."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Previsioni future dei livelli di glucosio e del dosaggio di insulina per pasti imprevisti o altre cause di aumento della lettura di glucosio senza preavviso."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Forecasts future glucose levels and insulin dosing needs for unexpected meals or other causes of glucose reading increases without prior notice."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beregner fremtidige blodsukkernivåer og insulinbehov for uanmeldte måltider eller andre årsaker til økt blodsukker uten forhåndsvarsling."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het voorspellen van toekomstige glucosewaardes en de behoefte aan insulinedoseringen voor onverwachte maaltijden of andere oorzaken van glucosewaarde stijgt zonder voorafgaande kennisgeving."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prognozuje przyszłe poziomy glikemii i zapotrzebowanie na dawkę insuliny w przypadku nieoczekiwanych posiłków lub innych przyczyn wzrostu stężenia glikemii bez wcześniejszego powiadomienia."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prevê níveis de glicose futuros e a dosagem insulina para refeições inesperadas ou outras causas de aumento da leitura de glicose sem aviso prévio."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Forecasts future glucose levels and insulin dosing needs for unexpected meals or other causes of glucose reading increases without prior notice."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прогнозирует будущие уровни глюкозы и потребности инсулина для дозирования непредвиденных блюд или других причин увеличения количества глюкозы без предварительного уведомления."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prognos över framtida glukosnivåer och insulindoseringsbehov utifrån oväntade måltider eller andra orsaker till att glukosavläsningarna ökar utan förvarning."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Forecasts future glucose levels and insulin dosing needs for unexpected meals or other causes of glucose reading increases without prior notice."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прогнози майбутніх рівнів глюкози та потреби в дозі інсуліну для несподіваних страв або інших причин підвищення глюкози без попереднього повідомлення."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dự báo mức đường huyết trong tương lai và nhu cầu insulin khi có bữa ăn bất ngờ hoặc các nguyên nhân khác khiến đường huyết tăng mà không được thông báo trước."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "預測未預告的餐點或其他因素導致血糖讀取值增加的未來血糖水平和胰島素劑量需求。"
          }
        }
      }
    },
    "Forecasts future glucose reading changes by considering the amount of carbohydrates still being absorbed in the body." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прогнозира бъдещите промени в показанията на глюкозата, като отчита количеството въглехидрати, които все още се абсорбират от организма."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Předpovídá budoucí změny glykémie na základě množství sacharidů, které se stále vstřebávají v těle."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prognoser fremtidige glukose aflæsning ændringer ved at overveje mængden af kulhydrater stadig absorberes i kroppen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
