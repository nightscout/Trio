    "Trio includes several algorithm settings that allow you to customize the oref algorithm behavior to suit your specific needs." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio включва няколко настройки на алгоритъма, които ви позволяват да персонализирате поведението на алгоритъма oref, за да отговаря на специфичните ви нужди."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio obsahuje několik nastavení algoritmu, která ti umožňují přizpůsobit chování algoritmu OREF tvým specifickým potřebám."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio indeholder flere algoritme indstillinger, der giver dig mulighed for at tilpasse oref algoritme adfærd, der passer til dine specifikke behov."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
