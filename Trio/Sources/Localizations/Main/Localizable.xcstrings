    " Allow Trio to send you Notifications. These may include alerts, sounds, and icon badges." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Позволете на Trio да ви изпраща известия. Те може да включват предупреждения, звуци и значки на иконите."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Povolte aplikaci Trio zasílání oznámení. Mohou zahrnovat upozornění, zvuky a odznaky na ikoně."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Tillad Trio at sende dig notifikationer. Disse kan omfatte advarsler, lyde og ikonbadges."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Erlaube Trio, Dir Benachrichtigungen zu senden. Diese können Warnungen, Töne und App-Kennzeichen enthalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "new",
            "value" : " Allow Trio to send you Notifications. These may include alerts, sounds, and icon badges."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Autorisations données à l’application de Trio pour l’envoi de notifications, incluant alertes, sons et pastilles sur l’icône."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " אפשר ל-Trio לשלוח לך התראות. ייתכן שהתראות אלו יכללו התרעות קוליות, צלילים, וסמלים על האייקון."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Permetti al Trio di inviarti Notifiche. Questi potrebbero includere avvisi, suoni e badge di icone."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Trio가 알림을 보낼 수 있도록 허용합니다. 알림, 소리, 아이콘 배지가 포함될 수 있습니다."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Tillat at Trio sender deg varsler. Dette kan inkludere varslinger, lyder og ikonmerker."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Trio toestaan om u meldingen te sturen. Dit kunnen waarschuwingen, geluiden en icoonbadges zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Zezwól Trio na wysyłanie powiadomień. Mogą one obejmować alerty, dźwięki i ikony."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "new",
            "value" : " Allow Trio to send you Notifications. These may include alerts, sounds, and icon badges."
          }
        },
