    "Tap a percentile or tap and hold a bar to reveal more details. Swipe to scroll through time." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Натиснете перцентил или натиснете и задръжте стълб, за да се покажат повече детайли. Плъзнете, за да преминете през времето."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klepnutím na percentil nebo klepnutím a podržením sloupce zobrazíš detaily. Přejetím se posouváš v čase."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk på en procentil eller tryk og hold en bar nede for at vise flere detaljer. Stryg for at rulle gennem tid."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf einen Prozentsatz oder tippe und halte einen Balken, um weitere Details zu erhalten. Streiche, um durch die Zeit zu blättern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Tap a percentile or tap and hold a bar to reveal more details. Swipe to scroll through time."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez un centile ou touchez et maintenez une barre pour afficher plus de détails. Faites glisser pour naviguer dans le temps."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Tap a percentile or tap and hold a bar to reveal more details. Swipe to scroll through time."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Tap a percentile or tap and hold a bar to reveal more details. Swipe to scroll through time."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Tap a percentile or tap and hold a bar to reveal more details. Swipe to scroll through time."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk på en persentil eller trykk og hold en søyle for å vise mer detaljer. Sveip for å bla gjennom tid."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "new",
