    "This limits the automatic adjustment of the temporary basal rate to this percentage of the current hourly profile basal rate at the time of the loop cycle." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Това ограничава автоматичната корекция на временната базална доза до този процент от текущата часова базална доза на профила в момента на loop цикъла."
          }
        },
        "cs" : {
          "stringUnit" : {
