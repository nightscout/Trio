    "Live activity displays blood glucose live on the lock screen and on the dynamic island (if available)" : {
      "comment" : "Notification option",
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live Activity показва кръвната захар на живо на заключения екран и в Dynamic Island (ако е налично)"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Živá aktivita zobrazuje glykémii v reálném čase na zamknuté obrazovce a v Dynamic Islandu (pokud je k dispozici)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live aktivitet viser blodglukose live på låseskærmen og på den dynamiske ø (hvis tilgængelig)"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live-Aktivität zeigt die Glukose live auf dem Sperrbildschirm und auf der dynamischen Insel (falls verfügbar) an"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live activity displays blood glucose live on the lock screen and on the dynamic island (if available)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La actividad en vivo muestra la glucosa en vivo en la pantalla de bloqueo y en la isla dinámica (si está disponible)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Activité en direct\" permet d’afficher la mesure de glycémie en temps réel sur l’écran verrouillé et, si votre appareil est compatible, dans le Dynamique Island"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Live activity displays blood glucose live on the lock screen and on the dynamic island (if available)"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'attività in tempo reale visualizza la glicemia in tempo reale sulla schermata di blocco e sulla Dynamic Island (se disponibile)"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Live activity displays blood glucose live on the lock screen and on the dynamic island (if available)"
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oppdateringer i sanntid viser blodsukker live på låseskjermen og på den dynamiske øya (hvis tilgjengelig)"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De 'Live activiteit' toont bloedglucose op het vergrendelscherm en op het Dynamische Island (indien beschikbaar).\n\nDynamic Island vervangt de traditionele statische 'notch' (inkeping) aan de bovenkant van de iPhone-schermen"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktywność na żywo wyświetla stężenie glikemii we krwi na ekranie blokady i na dynamicznej wyspie (jeśli jest dostępna)"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atividade ao vivo exibe glicemia ao vivo na tela de bloqueio e na ilha dinâmica (se disponível)"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Live activity displays blood glucose live on the lock screen and on the dynamic island (if available)"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эфир активности - в реальном времени отображает уровень глюкозы в крови на экране блокировки и на динамическом островке Dynamic Island (если доступно)"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liveaktivitet visar senaste glukosavläsning på låsskärmen och på Dynamic Island, om en sådan finns på din iPhone-modell"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Live activity displays blood glucose live on the lock screen and on the dynamic island (if available)"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дії наживо відображає рівень глюкози в крові в прямому ефірі на екрані блокування та на динамічному острові (якщо доступний)"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoạt động Trực tiếp (Live Activity) hiển thị mức đường huyết theo thời gian thực trên màn hình khóa và trên Dynamic Island (nếu có)"
          }
        },
        "zh-Hant" : {
