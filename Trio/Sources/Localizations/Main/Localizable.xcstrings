    "Note to Medtronic Pump Users: You must also manually set the max basal rate on the pump to this value or higher." : {
      "extractionState" : "stale",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Забележка за потребителите на помпи Medtronic: Трябва също да зададете ръчно макс. базал на помпата на тази стойност или по-висока."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poznámka pro uživatele pump Medtronic: Na pumpě musíš také manuálně nastavit maximální bazální dávku na tuto hodnotu nebo vyšší."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bemærk til Medtronic Pump brugere: Du skal også manuelt indstille den maksimale basal rate på pumpen til denne værdi eller højere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hinweis für Benutzer von Medtronic-Pumpen: Der Wert an der Pumpe muss auch auf die maximale Basalrate oder einen noch höheren Wert eingestellt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note to Medtronic Pump Users: You must also set the max basal rate on the pump to this value or higher ."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remarque à l’attention des utilisateurs de pompes Medtronic : vous devez également régler manuellement le débit basal maximal sur la pompe à cette valeur ou à une valeur supérieure."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Note to Medtronic Pump Users: You must also manually set the max basal rate on the pump to this value or higher."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nota agli utenti della pompa Medtronic: È necessario impostare manualmente la velocità basale massima sul microinfusore a questo valore o superiore."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Note to Medtronic Pump Users: You must also manually set the max basal rate on the pump to this value or higher."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merknad til brukere av Medtronic-pumper: Du må også sette maksimal basalrate manuelt på pumpen til denne verdien eller høyere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opmerking voor Medtronic-pompgebruikers: Je moet ook handmatig de maximale basaalsnelheid van de pomp op deze waarde (of hoger) zetten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uwaga dla użytkowników pompy Medtronic: Musisz również ręcznie ustawić maksymalną dawkę bazową na pompie na tę wartość lub wyższą."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nota para os usuários da Bomba Medtronica: Você também deve definir manualmente o valor máximo da basal na bomba para este valor ou superior."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Note to Medtronic Pump Users: You must also manually set the max basal rate on the pump to this value or higher."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Примечание для пользователей Medtronic Pump Users: Вы также должны вручную установить максимальную базовую скорость насоса в это значение или выше."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obs till Medtronic pump-användare: Du måste också manuellt ställa in den maximala basalen på pumpen till detta värde eller högre."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Note to Medtronic Pump Users: You must also manually set the max basal rate on the pump to this value or higher."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зверніть увагу на користувачів Medtronic Pump: Ви також повинні вручну встановити макс. базову швидкість на насосі або вище значення."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lưu ý cho người dùng máy bơm Medtronic: Bạn cũng phải tự tay đặt tỷ lệ liều nền tối đa trên máy bơm ở giá trị này hoặc cao hơn."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "注意：對於美敦力幫浦用戶，你必須在幫浦上手動將最大基礎率設定為此數值或更高。"
          }
        }
      }
    },
    "Note: A CGM is considered noisy when it provides inconsistent readings." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Забележка: CGM се счита за шумен, когато дава непоследователни показания."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poznámka: CGM je považován za „zašuměný“, pokud poskytuje nekonzistentní hodnoty."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bemærk: Et CGM betragtes som støjende, når det giver inkonsekvente aflæsninger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hinweis: Ein CGM gilt als verrauscht, wenn es inkonsistente Messwerte liefert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nota: Un CGM se considera ruidoso cuando proporciona lecturas inconsistentes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remarque : Un capteur de glycémie (CGM) est considéré comme bruyant lorsqu’il fournit des mesures incohérentes."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Note: A CGM is considered noisy when it provides inconsistent readings."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nota: Una CGM è considerata rumorosa quando fornisce letture incoerenti."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Note: A CGM is considered noisy when it provides inconsistent readings."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merk: En CGM anses for å være støyende når den gir inkonsekvente avlesninger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opmerking: een CGM wordt beschouwd als lawaaierig wanneer het inconsistente metingen bevat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uwaga: CGM uważa się za system o zakłóconych odczytach, jeśli dostarcza niejednoznacznych wyników."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nota: Um CGM é considerado barulho quando fornece leituras inconsistentes."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Note: A CGM is considered noisy when it provides inconsistent readings."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Примечание: КГМ считается шумным, когда он обеспечивает непоследовательное чтение."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obs: Ett CGM anses brusiga när det ger inkonsekventa avläsningar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Note: A CGM is considered noisy when it provides inconsistent readings."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Примітка: CGM вважається шумом, коли надає непослідовні дані."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lưu ý: CGM được coi là có nhiễu khi cung cấp số liệu không nhất quán."
          }
