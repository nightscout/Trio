          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Glukose-Hinweis wird NICHT von Insulin- oder Kohlenhydrat-Einträgen beeinflusst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El rastro de glucosa NO se verá afectado por ninguna entrada de insulina o carbohidrógeno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
