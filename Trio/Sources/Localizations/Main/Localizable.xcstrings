            "state" : "new",
            "value" : "This difference exists because situations like exercise often need a much larger insulin reduction than Autosens would detect during a normal daily routine."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This difference exists because situations like exercise often need a much larger insulin reduction than Autosens would detect during a normal daily routine."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
