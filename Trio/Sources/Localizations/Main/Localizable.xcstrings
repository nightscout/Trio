          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przełącznik Przesyłania Terapii umożliwia przesyłanie następujących zbiorów danych na adres URL podłączonego Nightscout:"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os Tratamentos de Envio alternam o upload dos seguintes conjuntos de dados para sua URL do Nightscout conectada:"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
