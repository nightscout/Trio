    "If Half Basal Exercise Target is %@ %@, a Temp Target of %@ %@ uses an Autosens Ratio of 1.09. A Temp Target of %@ %@ uses an Autosens Ratio of 1.33." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ако Half Basal Exercise Target е %@ %@, временна цел от %@ %@ използва съотношение Autosens 1.09. Временна цел от %@ %@ използва съотношение Autosens 1.33."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud je cíl pro cvičení s polovičním bazálem %1$@ %2$@, dočasný cíl %3$@ %4$@ používá poměr Autosens 1,09. Dočasný cíl %5$@ %6$@ pak používá poměr Autosens 1,33."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis halvbasalmotionsmål er %1$@ %2$@, a Temp Target for %3$@ %4$@ bruger en Autosens Ratio på 1. 9. Et Temp Target for %5$@ %6$@ bruger en Autosens Ratio på 1,33."
          }
        },
        "de" : {
          "stringUnit" : {
