      }
    },
    "Auto-sensitivity (Autosens) adjusts insulin delivery based on observed sensitivity or resistance." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autosens регулира подаването на инсулин на база наблюдавана чувствителност или резистентност."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatická citlivost (Autosens) upravuje podávání inzulínu na základě pozorované citlivosti nebo rezistence."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto-sensitivitet (Autosens) justerer insulindispensionen baseret på observeret sensitivitet eller resistens."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto-Sensitivität (Autosens) passt die Insulinabgabe auf der Grundlage der beobachteten Empfindlichkeit oder Resistenz an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Auto-sensitivity (Autosens) adjusts insulin delivery based on observed sensitivity or resistance."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sensibilité automatique (Autosens) ajuste l’administration d’insuline en fonction de la sensibilité ou de la résistance observée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Auto-sensitivity (Autosens) adjusts insulin delivery based on observed sensitivity or resistance."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sensibilità automatica (Autosens) regola la somministrazione d'insulina in base alla sensibilità o resistenza osservate."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Auto-sensitivity (Autosens) adjusts insulin delivery based on observed sensitivity or resistance."
          }
