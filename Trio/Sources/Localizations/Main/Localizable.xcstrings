          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переключатель загрузки/выгрузки данных позволяет загружать следующие наборы данных в ваш URL, подключенный к Nightscout:"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om du aktiverar 'Tillåt uppladdning till Nightscout' tillåts uppladdning av följande data till din anslutna Nightscout URL:"
          }
        },
        "tr" : {
          "stringUnit" : {
