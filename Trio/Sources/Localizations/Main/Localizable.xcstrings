    "Tip: Decreasing this value allows automatic adjustments of basal rates to be lower, ISF to be higher, and CR to be higher." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Съвет: Намаляването на тази стойност позволява автоматичните корекции на базалните дози да бъдат по-ниски, ISF да бъде по-висок и CR да бъде по-висок."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tip: Snížení této hodnoty umožňuje, aby automatické úpravy bazálních dávek byly nižší a aby ISF i CR mohly být vyšší."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tip: Ved at reducere denne værdi kan automatiske justeringer af basale satser være lavere, ISF er højere, og CR er højere."
          }
        },
        "de" : {
          "stringUnit" : {
