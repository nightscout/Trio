    "Check device settings, connect to phone, and try again." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверете настройките на устройството, свържете го с телефона и опитайте отново."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zkontrolujte nastavení zařízení, připojte se k telefonu a zkuste to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tjek enhedens indstillinger, forbind til telefonen, og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überprüfe die Geräteeinstellungen, stelle eine Verbindung zum Telefon her, und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compruebe la configuración del dispositivo, conéctese al teléfono y vuelva a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez les réglages de l’appareil, connectez-le au téléphone, puis réessayez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Check device settings, connect to phone, and try again."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla le impostazioni del dispositivo, connetti al telefono e riprova."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Check device settings, connect to phone, and try again."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontroller enhetsinnstillinger, koble til telefonen, og prøv på nytt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apparaatinstellingen controleren, verbinding maken met telefoon en probeer het opnieuw."
