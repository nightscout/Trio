    "Manually backdate some recent carbs or insulin you’ve entered in the last 6 to 8 hours." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Въведете ръчно със задна дата скорошни въглехидрати или инсулин, които сте записали през последните 6 до 8 часа."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Změň zpětně čas u sacharidů nebo inzulínu, které jsi zadal v posledních 6 až 8 hodinách."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilbagedater manuelt nogle nylige kulhydrater eller insulin du har indtastet inden for de sidste 6 til 8 timer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manuelle Rückdatierung der in den letzten 6 bis 8 Stunden eingegebenen Kohlenhydrate oder Insulinmengen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Manually backdate some recent carbs or insulin you’ve entered in the last 6 to 8 hours."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifiez manuellement la date de certains ajouts récents de glucides ou d’insuline effectués au cours des 6 à 8 dernières heures, en remplaçant leur date actuelle par une date antérieure."
          }
        },
        "he" : {
