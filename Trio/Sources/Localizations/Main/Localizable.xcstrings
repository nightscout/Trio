    "Trio comes with a helpful Startup Guide. We recommend opening it now and following along as you go — side by side." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio се предоставя с полезно ръководство за започване. Препоръчваме да го отворите сега и да го следвате, докато работите — едно до друго."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio Ti pomůže s prvotním základním nastavením. Doporučuji jít pečlivě bod po bodu.  "
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio kommer med en nyttig Startup Guide. Vi anbefaler at åbne den nu og følge med, mens du sætter op – side om side."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio wird mit einer hilfreichen Startup-Anleitung geliefert. Wir empfehlen Dir, diese jetzt zu öffnen und sie Seite für Seite durchzuarbeiten."
          }
        },
        "es" : {
          "stringUnit" : {
