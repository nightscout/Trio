    "Trio does not have enough closed-loop data to enable Dynamic ISF. This data collection can take up to 7 days." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio няма достатъчно данни от затворен loop, за да активира Dynamic ISF. Това събиране на данни може да отнеме до 7 дни."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio nemá dostatek dat z uzavřené smyčky k zapnutí funkce Dynamic ISF. Sběr těchto dat může trvat až 7 dní."
