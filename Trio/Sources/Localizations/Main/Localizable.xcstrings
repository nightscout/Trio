    "Your insulin sensitivity factor (ISF) indicates how much one unit of insulin will lower your blood glucose. This helps calculate correction boluses." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вашият фактор на инсулинова чувствителност (ISF) показва с колко една единица инсулин ще понижи кръвната ви захар. Това помага за изчисляване на коригиращи болуси."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvůj faktor citlivosti na inzulín (ISF) udává, o kolik jedna jednotka inzulínu sníží tvou hladinu glykémie. To pomáhá vypočítat korekční bolusy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din insulinsensitivitetsfaktor (ISF) angiver, hvor meget en enhed insulin vil sænke dit blodsukker. Dette hjælper med at beregne korrektionsbolusser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Insulinempfindlichkeitsfaktor (ISF) gibt an, um wie viel eine Einheit Insulin Deinen Blutzucker senken wird. Dies hilft bei der Berechnung von Korrekturbolusgaben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Your insulin sensitivity factor (ISF) indicates how much one unit of insulin will lower your blood glucose. This helps calculate correction boluses."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre facteur de sensibilité à l’insuline (ISF) indique de combien une unité d’insuline fait baisser votre niveau de glucose. Cela aide à calculer les bolus de correction."
          }
        },
        "he" : {
