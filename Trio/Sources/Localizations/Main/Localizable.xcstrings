    "Swipe left to edit or delete a temporary target preset. Hold, drag and drop to reorder a preset." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Плъзнете наляво, за да редактирате или изтриете шаблон за временна цел. Задръжте и плъзгайте, за да пренаредите шаблон."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
