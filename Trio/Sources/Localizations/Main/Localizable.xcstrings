    "This setting restricts the maximum temporary basal rate Trio can set. At the default of 300%, it caps it at 3 times your highest programmed basal rate." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тази настройка ограничава максималната временна базална доза, която Trio може да зададе. При стойност по подразбиране от 300%, я ограничава до 3 пъти най-високата ви програмирана базална доза."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto nastavení omezuje maximální dočasný bazál, který může Trio nastavit. Při výchozých 300 % je stropem trojnásobek tvého nejvyššího naprogramovaného bazálu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne indstilling begrænser den maksimale midlertidige basale sats Trio kan indstille. Som standard på 300%, det hætter det på 3 gange din højeste programmerede basal sats."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Einstellung schränkt die maximale Temporäre Basalrate ein, die Trio einstellen kann. Bei der Standardeinstellung von 300 % ist sie auf das Dreifache Deiner höchsten programmierten Basalrate begrenzt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este ajuste restringe la tasa basal máxima temporal que Trio puede establecer. Al valor por defecto de 300%, lo limita a 3 veces la tasa basal programada más alta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce réglage restreint le débit basal temporaire maximal que Trio peut appliquer. Par défaut, à 300 %, il le plafonne à trois fois le débit basal le plus élevé défini dans votre profil basal."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This setting restricts the maximum temporary basal rate Trio can set. At the default of 300%, it caps it at 3 times your highest programmed basal rate."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa impostazione limita il Trio di velocità basale massima temporaneamente impostata. Al default del 300%, lo limita a 3 volte il tuo più alto tasso basale programmato."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This setting restricts the maximum temporary basal rate Trio can set. At the default of 300%, it caps it at 3 times your highest programmed basal rate."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne innstillingen begrenser maksimal midlertidig basalrate som Trio kan sette. Ved standardverdien på 300%, begrenses det til 3 ganger din høyeste basalrate."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze instelling beperkt de maximale tijdelijke basaalsnelheid die Trio kan instellen. De standaard van 300% zorgt ervoor dat het beperkt blijft tot 3x je hoogst geprogrammeerde basaalsnelheid."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To ustawienie ogranicza maksymalną tymczasową dawkę podstawową, jaką Trio może ustawić. Przy wartości domyślnej 300%, ogranicza ją do 3-krotności najwyższej zaprogramowanej dawki bazowej."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta configuração restringe a taxa máxima de basal temporária Trio pode ser definida. Ao padrão de 300%, ele capta a sua taxa basal mais alta programada."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This setting restricts the maximum temporary basal rate Trio can set. At the default of 300%, it caps it at 3 times your highest programmed basal rate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот параметр ограничивает максимальную временную базовую скорость Трио может установиться. По умолчанию в 300%, он переводит его в 3 раза больше, чем ваш базовый уровень."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denna inställning begränsar den maximala temporära basalnivån Trio kan ställa in. Vid standardinställningen 300%, är den högsta tillåtna temporära basalen 3 gånger din högsta programmerade basal."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This setting restricts the maximum temporary basal rate Trio can set. At the default of 300%, it caps it at 3 times your highest programmed basal rate."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цей параметр обмежує максимально допустиму кількість тимчасових значень для цього рівня. При дефолті 300%, він покриває його втричі більше запрограмованої базової ставки."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cài đặt này giới hạn tốc độ insulin nền tạm thời tối đa mà Trio có thể thiết lập. Mặc định là 300%, nghĩa là hệ thống sẽ không vượt quá 3 lần tốc độ nền cao nhất mà bạn đã cài đặt."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這個設定限制了 Trios 可以設定的最大臨時基礎率。在預設值300%下，它將其限制在你設定的最高基礎率的3倍。"
          }
        }
      }
    },
