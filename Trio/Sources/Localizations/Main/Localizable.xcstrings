    "Loop will not automatically adjust your insulin delivery until the temporary basal rate finishes or is canceled." : {
      "comment" : "Description text on manual temp basal action sheet",
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loop няма автоматично да коригира подаването на инсулин, докато временната базална доза не приключи или не бъде отменена."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smyčka nebude automaticky upravovat dávkování inzulínu, dokud neskončí nebo nebude zrušen dočasný bazál."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loop vil ikke automatisk justere din insulinlevering, før den midlertidige basal sats er færdig eller er annulleret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loop passt Deine Insulinabgabe nicht automatisch an, bis die Temporäre Basalrate beendet oder abgebrochen wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loop will not automatically adjust your insulin delivery until the temporary basal rate finishes or is canceled."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bucle no ajustará automáticamente su entrega insulina hasta que la tasa basal temporal termine o sea cancelada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La boucle fermée n’ajustera pas automatiquement l’administration d’insuline tant que le débit basal temporaire n’est pas terminé ou annulé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Loop will not automatically adjust your insulin delivery until the temporary basal rate finishes or is canceled."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loop non regolerà automaticamente l'erogazione d'insulina fino a quando l'impostazione della basale temporanea non sarà terminata o cancellata."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Loop will not automatically adjust your insulin delivery until the temporary basal rate finishes or is canceled."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appen vil ikke automatisk justere insulintilførselen før den manuelle basalraten er fullført eller kansellert."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio zal niet automatisch veranderingen aanbrengen in de hoeveelheid insuline die je krijgt, totdat de tijdelijke basaalsnelheid is gestopt of geannuleerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pętla nie będzie automatycznie dostosowywać podawania insuliny, dopóki tymczasowa dawka podstawowa nie zakończy się lub nie zostanie anulowana."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O loop não ajustará automaticamente sua entrega de insulina até que a taxa temporária de basal termine ou seja cancelada."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Loop will not automatically adjust your insulin delivery until the temporary basal rate finishes or is canceled."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Петля не будет автоматически изменять подачу инсулина, пока Временная Базальная Скорость не завершится, либо не будет отменена пользователем."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio kommer inte automatiskt att justera dina insulindoser förrän den temporära basalen är färdig eller har avbrutits."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Loop will not automatically adjust your insulin delivery until the temporary basal rate finishes or is canceled."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Петля не автоматично змінюватиме подачу інсуліну, поки Тимчасова Базальна Швидкість не завершиться, або не буде скасована користувачем."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loop sẽ không tự động điều chỉnh liều insulin đến khi liều nền tạm thời thực hiện xong hoặc bị hủy bỏ."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "循環在臨時基礎率結束或取消之前，不會自動調整您的胰島素給藥。"
          }
        }
      }
    },
