    "Most set this to their largest meal bolus. Then, adjust if needed." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повечето задават тази стойност равна на най-големия си болус за хранене. След това коригирайте при нужда."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Většina lidí zde nastavuje svůj největší bolus k jídlu. V případě potřeby pak hodnotu uprav."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De fleste sæt dette til deres største måltid bolus. Juster derefter, hvis det er nødvendigt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die meisten setzen dies auf ihren größten Mahlzeitenbolus. Passe den Wert bei Bedarf an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mayoría establece esto en su bolo de comida más grande. Luego, ajuste si es necesario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La plupart des utilisateurs définissent cette valeur en fonction de leur plus gros bolus pour un repas. Ils l’ajustent ensuite si nécessaire."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Most set this to their largest meal bolus. Then, adjust if needed."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La maggior parte impostare questo al loro bolo pasto più grande. Quindi, regolare, se necessario."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Most set this to their largest meal bolus. Then, adjust if needed."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De fleste setter denne tilsvarende sin største måltidsbolus. Endre deretter etter behov."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stel dit meestal in op hun grootste maaltijd bolus. Pas vervolgens aan indien nodig."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Większość z nich ustawia to na największy bolus. Następnie, w razie potrzeby dostosować."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A maioria definiu isso como seu maior bolus de refeição. Então, ajuste se necessário."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Most set this to their largest meal bolus. Then, adjust if needed."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Большинство из них выставили свой самый большой болт. Затем при необходимости подстраивайтесь."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De flesta ställer in detta till att motsvara sin största måltidsbolus. Justera därefter efter behov."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
