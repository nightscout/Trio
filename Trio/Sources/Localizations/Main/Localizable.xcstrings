    "Connect to your insulin pump so Trio can send dosing commands and stay active in the background." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Свържете се с вашата инсулинова помпа, за да може Trio да изпраща команди за дозиране и да остане активен във фонов режим."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Připoj se ke své inzulínové pumpě, aby Trio mohlo odesílat příkazy k dávkování a zůstalo aktivní na pozadí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilslut insulinpumpen, så Trio kan sende doseringskommandoer og forblive aktive i baggrunden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stelle eine Verbindung zu Deiner Insulinpumpe her, damit Trio Dosierungsbefehle senden kann und im Hintergrund aktiv bleibt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Connect to your insulin pump so Trio can send dosing commands and stay active in the background."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez-vous à votre pompe à insuline pour que Trio puisse envoyer les commandes de dosage et rester actif en arrière-plan."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Connect to your insulin pump so Trio can send dosing commands and stay active in the background."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connettiti alla pompa insulinica in modo che Trio possa inviare comandi di erogazione e rimanere attivo in background."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Connect to your insulin pump so Trio can send dosing commands and stay active in the background."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koble til insulinpumpen din slik at Trio kan sende doseringskommandoer og holde appen aktiv i bakgrunnen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maak verbinding met je insuline pomp, zodat Trio doseer commando's kan versturen en op de achtergrond actief kan blijven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Połącz się z pompą insulinową, aby Trio mogło wysyłać polecenia dawkowania i działać w tle."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Connect to your insulin pump so Trio can send dosing commands and stay active in the background."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Connect to your insulin pump so Trio can send dosing commands and stay active in the background."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Connect to your insulin pump so Trio can send dosing commands and stay active in the background."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anslut till din insulinpump så att Trio kan skicka doseringskommandon och hålla sig aktiv i bakgrunden."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Connect to your insulin pump so Trio can send dosing commands and stay active in the background."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Connect to your insulin pump so Trio can send dosing commands and stay active in the background."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kết nối với máy bơm insulin để Trio có thể gửi lệnh dùng thuốc và hoạt động ở chế độ nền."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "連接到您的胰島素幫浦，以便 Trio 能夠發送劑量命令並在後台保持活躍。"
          }
        }
      }
    },
