          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette er en sikkerhetsbegrensning for å unngå høye SMB-doser når blodsukkeret stiger unormalt raskt, slik som etter et måltid eller med en veldig unøyaktig CGM-sensor."
