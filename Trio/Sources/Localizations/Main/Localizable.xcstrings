    "This is the maximum basal rate allowed to be set or scheduled. This applies to both automatic and manual basal rates." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Това е максималната базална доза, която е разрешено да бъде зададена или планирана. Това важи както за автоматичните, така и за ръчните базални дози."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto je maximální bazální dávka, kterou lze nastavit nebo naplánovat. Platí pro automatické i manuální bazální dávky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette er den maksimale basale sats, der er tilladt at indstille eller planlagt. Dette gælder både automatiske og manuelle basale satser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies ist die maximale zulässige Basalrate. Dies gilt sowohl für automatische als auch manuell gesetzte Basalraten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta es la tarifa basal máxima permitida para fijar o programar. Esto se aplica tanto a las tarifas basales manuales como automáticas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il s’agit du débit basal maximal autorisé, qu’il soit défini manuellement ou planifié dans le profil basal. Cette limite s’applique aux débits basaux automatiques et manuels."
          }
        },
        "he" : {
