    "Nightscout is a cloud-based platform that allows you to store your diabetes data. It's often used by caregivers to remotely monitor what Trio is doing." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nightscout е облачна платформа, която ви позволява да съхранявате данните си за диабета. Често се използва от близки, за да наблюдават дистанционно какво прави Trio."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nightscout je cloudová platforma, která umožňuje ukládat tvá data o diabetu. Často ji využívají pečující osoby ke vzdálenému sledování toho, co Trio dělá."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nightscout er en cloud-baseret platform, der giver dig mulighed for at gemme dine diabetes data. Det bruges ofte af plejere til at fjernovervåge, hvad Trio gør."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nightscout ist eine cloudbasierte Plattform, auf der Du Deine Diabetesdaten speichern kannst. Sie wird häufig von Betreuungspersonen genutzt, um die Aktivitäten von Trio aus der Ferne zu überwachen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Nightscout is a cloud-based platform that allows you to store your diabetes data. It's often used by caregivers to remotely monitor what Trio is doing."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nightscout est une plateforme Cloud qui permet de stocker vos données liées au diabète. Elle est souvent utilisée par les aidants pour suivre à distance l’activité de Trio."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Nightscout is a cloud-based platform that allows you to store your diabetes data. It's often used by caregivers to remotely monitor what Trio is doing."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Nightscout is a cloud-based platform that allows you to store your diabetes data. It's often used by caregivers to remotely monitor what Trio is doing."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Nightscout is a cloud-based platform that allows you to store your diabetes data. It's often used by caregivers to remotely monitor what Trio is doing."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nightscout er en skybasert plattform som lar deg lagre dine diabetesdata. Den brukes ofte av omsorgspersoner for å overvåke hva Trio gjør."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nightscout is een cloud-gebaseerd platform waarmee je diabetes gegevens kunt opslaan. Het wordt vaak gebruikt door zorgverleners om op afstand te controleren wat Trio doet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nightscout to oparta na chmurze platforma, która umożliwia przechowywanie danych dotyczących glikemii. Jest często używana przez opiekunów do zdalnego monitorowania działań Trio."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Nightscout is a cloud-based platform that allows you to store your diabetes data. It's often used by caregivers to remotely monitor what Trio is doing."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Nightscout is a cloud-based platform that allows you to store your diabetes data. It's often used by caregivers to remotely monitor what Trio is doing."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Nightscout is a cloud-based platform that allows you to store your diabetes data. It's often used by caregivers to remotely monitor what Trio is doing."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nightscout är en molnbaserad plattform som låter dig lagra dina diabetesdata. Den används ofta av vårdgivare för att monitorera vad Trio gör."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Nightscout is a cloud-based platform that allows you to store your diabetes data. It's often used by caregivers to remotely monitor what Trio is doing."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Nightscout is a cloud-based platform that allows you to store your diabetes data. It's often used by caregivers to remotely monitor what Trio is doing."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nightscout là một công cụ lưu trữ dữ liệu tiểu đường trên đám mây, thường được người chăm sóc sử dụng để giám sát từ xa những gì Trio đang thực hiện."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nightscout 是一個雲端平台，讓您儲存糖尿病資料。照顧者通常使用它來遠端監控 Trio 的運作。"
          }
        }
      }
