    "Sensor might have temporarily stopped, fallen off or is too cold or too warm" : {
      "comment" : "ensor might have temporarily stopped, fallen off or is too cold or too warm",
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сензорът може временно да е спрял, да е паднал или да е прекалено студен или прекалено топъл"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senzor mohl dočasně přestat měřit, vypadnout nebo je příliš studený či teplý."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensoren er muligvis midlertidigt stoppet, faldet af eller er for kold eller for varm"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Sensor ist möglicherweise vorübergehend ausgefallen, abgefallen oder zu kalt oder zu warm"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensor might have temporarily stopped, fallen off or is too cold or too warm"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El sensor podría haberse detenido temporalmente, caído o es demasiado frío o demasiado caliente"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le capteur de glucose a peut-être cessé temporairement de fonctionner, soit il s’est décollé, est trop froid ou trop chaud"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Sensor might have temporarily stopped, fallen off or is too cold or too warm"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il sensore potrebbe essersi interrotto temporaneamente, caduto o troppo freddo o troppo caldo"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Sensor might have temporarily stopped, fallen off or is too cold or too warm"
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensoren kan ha stoppet midlertidig, falt av eller er for kald eller for varm"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
