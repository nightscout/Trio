    "Stay in open loop (no automated dosing) for a bit to help Trio catch up to keep you safe" : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Останете в отворен цикъл (без автоматизирано дозиране) за малко, за да може Trio да навакса и да ви пази"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zůstaň chvíli v otevřené smyčce (bez automatického dávkování), aby tě Trio mohlo bezpečně dohnat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold dig åben loop (ingen automatiseret dosering) i lidt tid for at hjælpe Trio med at holde dig sikker"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bleib eine Zeit lang im \"offenen Loop\" (keine automatische Dosierung), damit Trio aufholen kann und Du sicher bist"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Stay in open loop (no automated dosing) for a bit to help Trio catch up to keep you safe"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restez en boucle ouverte (sans administration automatique) pendant un moment pour laisser à Trio le temps de se re-synchroniser pour garantir votre sécurité"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Stay in open loop (no automated dosing) for a bit to help Trio catch up to keep you safe"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
