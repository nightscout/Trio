          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlaag de gevoeligheid wanneer glucose onder het streefdoel ligt als er een handmatige tijdelijke streefdoel < %1$@ %2$@ is ingesteld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmniejsza wrażliwość gdy poziom glikemii jest poniżej celu, jeśli ustawiony jest ręczny cel tymczasowy < %1$@ %2$@"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
