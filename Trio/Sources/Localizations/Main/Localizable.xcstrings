    "Please authorize notifications by tapping 'Open iOS Settings' > 'Notifications' and enable 'Allow Notifications' for 'Notification Center' and 'Banners' Alerts." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Моля, разрешете известията, като натиснете „Отваряне на Настройки на iOS“ > „Известия“ и включите „Разрешаване на известията“ за предупрежденията „Център за известия“ и „Банери“."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povol prosím oznámení: klepni na „Otevřít nastavení iOS“ > „Oznámení“ a zapni „Povolit oznámení“ pro „Oznamovací centrum“ a „Bannery“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Godkend notifikationer ved at trykke på 'Åbn iOS-indstillinger' > 'Notifikationer' og aktiver 'Tillad notifikationer' for 'Notifikationscenter' og 'Banner'."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte lass Benachrichtigungen zu. Gehe hierfür in Deine iOS Einstellungen, navigiere zu \"Mitteilungen > Trio\" und aktiviere \"Mitteilungen erlauben\" und \"Banner\"-Warnungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por favor, autorice las notificaciones tocando 'Abrir ajustes de iOS' > 'Notificaciones' y active 'Permitir notificaciones' para 'Centro de notificaciones' y 'Alertas de banners'."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez les notifications en appuyant sur \"Ouvrir les Réglages iOS\", \"Notifications\", puis activez \"Autoriser les notifications\" pour les alertes \"Centre de notifications\" et \"Bannières\"."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Please authorize notifications by tapping 'Open iOS Settings' > 'Notifications' and enable 'Allow Notifications' for 'Notification Center' and 'Banners' Alerts."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorizza le notifiche premendo 'Apri impostazioni iOS' > 'Notifiche' e abilita 'Consenti notifiche' per 'Centro Notifiche' e 'Avvisi Banner'."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Please authorize notifications by tapping 'Open iOS Settings' > 'Notifications' and enable 'Allow Notifications' for 'Notification Center' and 'Banners' Alerts."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Godkjenn varsler ved å trykke \"Åpne iOS innstillinger\" > \"Varslinger\" og aktivere \"Tillat varsler\" for \"Varslingssenter\" og \"Bannere\"."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gelieve meldingen te autoriseren door op 'Open iOS Instellingen' > 'Meldingen' te tikken en 'Meldingen toestaan' in te schakelen voor 'Notificatie Center' en 'Banners' Alerts."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby zezwolić na powiadomienia, dotknij opcji „Otwórz ustawienia iOS” > „Powiadomienia”, a następnie włącz opcję „Zezwalaj na powiadomienia” dla alertów „Centrum powiadomień” i „Banery”."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por favor, autorize notificações tocando em 'Abrir Configurações do iOS' > 'Notificações' e habilite 'Permitir Notificações' para 'Alertas de Notificações' e 'Banners'."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Please authorize notifications by tapping 'Open iOS Settings' > 'Notifications' and enable 'Allow Notifications' for 'Notification Center' and 'Banners' Alerts."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пожалуйста, авторизуйте уведомления, нажав на 'Открыть настройки iOS > 'Уведомления' и 'Разрешить уведомления' для оповещений 'Центр уведомлений' и 'Баннеры'."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vänligen auktorisera notiser genom att trycka på \"Öppna iOS-inställningar\" > \"Notiser\" och aktivera \"Tillåt notiser\" för \"Notiscenter\" och \"Banderoller\"."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Please authorize notifications by tapping 'Open iOS Settings' > 'Notifications' and enable 'Allow Notifications' for 'Notification Center' and 'Banners' Alerts."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Будь ласка, авторизуйте сповіщення, натиснувши 'Налаштування iOS' > 'Сповіщення' і ввімкніть 'Дозволити сповіщення' для 'Центр сповіщень' та 'Банери' сигналів сповіщень."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vui lòng cho phép thông báo bằng cách nhấn vào 'Mở Cài đặt iOS' > 'Thông báo' và bật 'Cho phép Thông báo' cho 'Trung tâm Thông báo' và Cảnh báo 'Biểu ngữ'."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請透過點擊「開啟 iOS 設定」 > 「通知」，並啟用「允許通知」為「通知中心」和「橫幅」的提醒來授權通知。"
          }
        }
      }
    },
