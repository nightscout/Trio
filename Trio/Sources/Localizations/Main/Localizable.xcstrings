    "Autosens modifies Insulin Sensitivity Factor (ISF), basal rates, and target glucose. It doesn’t account for carbs but adjusts for insulin effectiveness based on patterns in your glucose data." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autosens променя фактора на инсулинова чувствителност (ISF), базалните дози и целевата глюкоза. Не отчита въглехидрати, а коригира ефективността на инсулина според модели във вашите данни за глюкоза."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autosens upravuje citlivost na inzulín (ISF), bazální dávky a cílovou glykémii. Nezohledňuje sacharidy, ale upravuje účinnost inzulínu na základě vzorců ve tvých datech o glykémii."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autosens modificerer insulinfølsomhedsfaktor (ISF), basalhastighed og glukosemål. Det gør ikke rede for kulhydrater, men justerer for insulineffektivitet baseret på mønstre i dine glukosedata."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autosens modifiziert den Insulinempfindlichkeitsfaktor (ISF), die Basalraten und das Glukoseziel. Es berücksichtigt keine Kohlenhydrate, sondern passt die Insulinwirksamkeit auf der Grundlage von Mustern in Deinen Glukosedaten an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Autosens modifies Insulin Sensitivity Factor (ISF), basal rates, and target glucose. It doesn’t account for carbs but adjusts for insulin effectiveness based on patterns in your glucose data."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sensibilité automatique \"Autosens\" modifie le facteur de sensibilité à l’insuline (ISF), le profil basal et les cibles de glucose. Il ne tient pas compte des glucides, mais ajuste l’efficacité de l’insuline en fonction des tendances observées dans vos mesures de glucose."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Autosens modifies Insulin Sensitivity Factor (ISF), basal rates, and target glucose. It doesn’t account for carbs but adjusts for insulin effectiveness based on patterns in your glucose data."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autosens modifica il fattore di sensibilità all'insulina (ISF), le percentuali basali e la glicemia target. Non tiene conto dei carboidrati, ma si regola per l'efficacia dell'insulina in base a modelli nei dati relativi alla tua glicemia."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Autosens modifies Insulin Sensitivity Factor (ISF), basal rates, and target glucose. It doesn’t account for carbs but adjusts for insulin effectiveness based on patterns in your glucose data."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autosens endrer insulinfølsomhet (ISF), basalrater og blodsukkermål. Autosens tar ikke med karbohydrater i beregningen, men justerer i henhold til trender i dine blodsukkerdata."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autosens wijzigt de insuline gevoeligheidsfactor (ISF), basaalstanden en streefdoel glucose. Koolhydraten zijn niet meegerekend, maar passen aan insuline-effectiviteit op basis van patronen in jouw glucosegegevens."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autosens modyfikuje współczynnik wrażliwości na insulinę (ISF), dawkę podstawową i docelową glikemię. Nie uwzględnia węglowodanów, ale dostosowuje skuteczność insuliny na podstawie wzorców w danych dotyczących glikemii."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Autosens modifies Insulin Sensitivity Factor (ISF), basal rates, and target glucose. It doesn’t account for carbs but adjusts for insulin effectiveness based on patterns in your glucose data."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Autosens modifies Insulin Sensitivity Factor (ISF), basal rates, and target glucose. It doesn’t account for carbs but adjusts for insulin effectiveness based on patterns in your glucose data."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Autosens modifies Insulin Sensitivity Factor (ISF), basal rates, and target glucose. It doesn’t account for carbs but adjusts for insulin effectiveness based on patterns in your glucose data."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autosens modifierar insulinkänslighetsfaktor (ISF), basalnivåer, och glukosmål. Den tar inte hänsyn till kolhydrater men justerar för aktuell insulineffektivitet baserat på identifierade mönster i dina glukosdata."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Autosens modifies Insulin Sensitivity Factor (ISF), basal rates, and target glucose. It doesn’t account for carbs but adjusts for insulin effectiveness based on patterns in your glucose data."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Autosens modifies Insulin Sensitivity Factor (ISF), basal rates, and target glucose. It doesn’t account for carbs but adjusts for insulin effectiveness based on patterns in your glucose data."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autosens điều chỉnh Hệ số nhạy cảm insulin (ISF), tỷ lệ cơ bản và đường huyết mục tiêu. Nó không tính đến carb nhưng điều chỉnh hiệu quả insulin dựa trên các mẫu trong dữ liệu đường huyết của bạn."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autosens 修改胰島素敏感性因子 (ISF)、基礎速率和目標血糖。它不考慮碳水化合物，但根據您的血糖資料中的模式調整胰島素的效果。"
          }
        }
      }
    },
