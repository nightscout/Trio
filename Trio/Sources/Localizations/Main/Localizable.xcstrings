          "stringUnit" : {
            "state" : "new",
            "value" : "Please wait up to 30 minutes before glucose readings are available!"
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vennligst vent opptil 30 minutter før blodsukker-avlesningen er tilgjengelig!"
          }
