    "Insulin Peak Time defines when insulin is most effective in lowering glucose, set in minutes after dosing." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пиковото време на инсулина определя кога инсулинът е най-ефективен в понижаването на глюкозата, зададено в минути след дозирането."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čas vrcholu účinku inzulínu určuje, kdy je inzulín nejúčinnější při snižování glukózy; nastavuje se v minutách od podání dávky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Insulins spidstidspunkt definerer, hvornår insulin er mest effektivt til at sænke glukosen, indstillet på få minutter efter indgift."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Insulin Wirkhöhepunkt legt fest, wann das Insulin bei der Senkung des Glukosespiegels am wirksamsten ist und wird in Minuten nach der Abgabe der Dosis angegeben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El tiempo pico de la insulina define cuando la insulina es más eficaz en la reducción de la glucosa, fijada en minutos después de la dosis."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La \"Durée avant pic d’action de l'insuline\" définit à quel moment l’insuline sera la plus efficace pour faire baisser le glucose. Elle est exprimée en nombre de minutes après son administration."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Insulin Peak Time defines when insulin is most effective in lowering glucose, set in minutes after dosing."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tempo di picco dell'insulina definisce quando l'insulina è più efficace nell'abbassare il glucosio, impostato in minuti dopo la somministrazione."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Insulin Peak Time defines when insulin is most effective in lowering glucose, set in minutes after dosing."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Topptid for insulineffekt definerer når insulinet er mest effektivt, satt i minutter etter dosering."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Insulin Peak Time bepaalt wanneer insuline het meest effectief is om glucose te verlagen, ingesteld in minuten na dosing."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szczyt działania insuliny określa, kiedy insulina jest najbardziej skuteczna w zmniejszaniu stężenia glukozy, ustawiona w kilka minut po podaniu."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Tempo Pico da Insulina define quando a insulina é mais eficaz na redução de glicose, definida em minutos após a dosagem."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Insulin Peak Time defines when insulin is most effective in lowering glucose, set in minutes after dosing."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Время пика инсулин определяет, когда инсулин наиболее эффективен в снижении глюкозы, устанавливается в минутах после дозирования."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Insulin Peak Time definierar när insulin är mest effektivt för att sänka glukos, som sätts i minuter efter dosering."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Insulin Peak Time defines when insulin is most effective in lowering glucose, set in minutes after dosing."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Інсуліновий пік визначає, коли інсулін є найбільш ефективним у зниженні глюкози, тобто через кілька хвилин після дозу."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thời gian insulin đạt đỉnh tác dụng xác định thời điểm insulin hiệu quả nhất trong việc làm giảm đường huyết, được thiết lập theo số phút sau khi tiêm."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "胰島素峰值時間定義了胰島素在降低葡萄糖方面最有效的時刻，設定為施打後的分鐘數。"
          }
        }
      }
    },
