        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stryg til venstre for at redigere eller slette et midlertidigt mål forudindstilling. Hold, træk og slip for at ændre en forudindstilling."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
