    "We strongly recommend not changing DIA — it’s essential to stable and safe operation." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Силно препоръчваме да не променяте DIA — тя е от съществено значение за стабилна и безопасна работа."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Důrazně doporučujeme DIA neměnit — je to zásadní pro stabilní a bezpečný provoz."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi anbefaler kraftigt ikke at ændre DIA — det er vigtigt for stabil og sikker drift."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
