        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在啟用前，請調整你的設定(基礎/胰島素敏感度/碳水化合物比率)，並熟悉該應用程式。"
          }
        }
      }
    },
    "Before you begin…" : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Преди да започнете…"
          }
        },
        "cs" : {
