    "This feature ensures more accurate insulin adjustments when carb entries are missing or incorrect." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тази функция осигурява по-точни корекции на инсулина, когато записите за въглехидрати липсват или са неточни."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tato funkce zajišťuje přesnější úpravy inzulínu v případech, kdy záznamy o sacharidech chybí nebo jsou nesprávné."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne funktion sikrer mere nøjagtige insulinjusteringer, når carb poster mangler eller er forkerte."
