        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Domyślnie wyłączone. Jeśli włączysz obniży cel glikemii, gdy autosens wykryje opór w działaniu insuliny"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O padrão é falso. Quando verdadeiro, diminuirá o alvo em glicemia quando autosens detectar resistência"
          }
        },
        "ro" : {
