    "Increase sensitivity when glucose is above target if a manual Temp Target > %@ %@ is set." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повишава чувствителността, когато глюкозата е над целта, ако е зададена ръчна временна цел > %@ %@."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvýší citlivost, když je glykémie nad cílem a je nastaven manuální dočasný cíl > %1$@ %2$@. "
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Øg følsomheden når glucose er over målet, hvis et manuelt temp mål > %1$@ %2$@ er indstillet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhöht die Empfindlichkeit, wenn die Glukose über dem Ziel liegt, wenn ein Temporäres Ziel > %1$@ %2$@ eingestellt ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Increase sensitivity when glucose is above target if a manual Temp Target > %1$@ %2$@ is set."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aumentar la sensibilidad cuando la glucosa está por encima del objetivo si se establece un objetivo temporal manual > %1$@ %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Augmenter la sensibilité lorsque le taux de glucose est au-dessus de la cible, si une Cible Temporaire manuelle > %1$@ %2$@ est définie."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Increase sensitivity when glucose is above target if a manual Temp Target > %1$@ %2$@ is set."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aumenta la sensibilità quando il glucosio è sopra il bersaglio se è impostato un obiettivo Temp manuale > %1$@ %2$@."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Increase sensitivity when glucose is above target if a manual Temp Target > %1$@ %2$@ is set."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Øk følsomheten når blodsukkeret er over målet dersom et midlertidig mål > %1$@ %2$@ er satt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verhoog de gevoeligheid als glucose hoger is dan het streefdoel als een handmatig tijdelijk streefdoel > %1$@ %2$@ is ingesteld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwiększa wrażliwość gdy poziom glikemii jest powyżej wartości docelowej, jeśli ustawiono ręczny cel tymczasowy > %1$@ %2$@"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aumentar sensibilidade quando a glicose estiver acima do alvo se um manual Temp Target > %1$@ %2$@ for definido."
          }
        },
        "ro" : {
