        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hệ số độ nhạy insulin (ISF) của bạn cho biết một đơn vị insulin sẽ làm giảm lượng đường huyết bao nhiêu. Thông số này giúp tính toán liều insulin điều chỉnh (bolus hiệu chỉnh)."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
