          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto je limit velikosti jednoho SMB při UAM. Jeden SMB při UAM může být maximálně tak velký, jako je tvá aktuální profilová bazální dávka za tento počet minut."
