    "If you prefer not to share this anonymized data, you can opt-out of data sharing." : {
      "extractionState" : "stale",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ако предпочитате да не споделяте тези анонимизирани данни, можете да се откажете от споделянето."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud tato anonymizovaná data sdílet nechceš, můžeš se ze sdílení odhlásit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du foretrækker ikke at dele disse anonymiserede data, kan du fravælge datadeling."
          }
