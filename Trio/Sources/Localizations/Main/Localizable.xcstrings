          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utløser en bekreftelsesdialog hvis du prøver å gi bolus når blodsukker er < %1$@ %2$@."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toont een bevestigingsvenster als je probeert te bolussen terwijl de glucose < %1$@ %2$@ is."
