          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hầu hết người dùng đặt giá trị này bằng liều bolus lớn nhất cho bữa ăn. Sau đó, điều chỉnh nếu cần."
