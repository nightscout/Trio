    "Of the total insulin delivered in the past 24 hours, this indicates what percentage was administered through basals and what was given through bolus." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "От общото количество инсулин, подаден през последните 24 часа, това показва какъв процент е подаден чрез базал и какъв – чрез болус."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z celkového množství inzulínu podaného za posledních 24 hodin tento údaj ukazuje, kolik procent bylo podáno prostřednictvím bazálů a kolik prostřednictvím bolusů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Af den totale mængde insulin, der er givet inden for de sidste 24 timer, indikerer dette, hvilken procentdel der blev administreret gennem basalerne, og hvad der blev givet gennem bolus."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vom gesamten Insulin, das in den letzten 24 Stunden abgegeben wurde, wird hier gezeigt, wieviel Prozent davon Basal und wie viel Bolus waren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De la insulina total entregada en las últimas 24 horas, esto indica qué porcentaje fue administrado a través de basales y lo que se dio a través del bolo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indique, sur la quantité totale d’insuline administrée au cours des 24 dernières heures, la part provenant du basal et celle administrée par bolus."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Of the total insulin delivered in the past 24 hours, this indicates what percentage was administered through basals and what was given through bolus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dell'insulina totale erogata nelle ultime 24 ore, questo indica quale percentuale è stata somministrata attraverso i basali e cosa è stato somministrato attraverso il bolo."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Of the total insulin delivered in the past 24 hours, this indicates what percentage was administered through basals and what was given through bolus."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Av det totale insulinet som gis de siste 24 timene, angir det hva prosentvis er administrert gjennom basaler og hva som er gitt gjennom bolus."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Van de totale hoeveelheid insuline die de afgelopen 24 uur is afgeleverd, geeft dit aan welk percentage is toegediend via basaal en wat er via bolus is gegeven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Informuje, jaki procent całkowitej dawki insuliny podanej w ciągu ostatnich 24 godzin podano w postaci dawki podstawowej a jaki w postaci bolusów."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da insulina total entregue nas últimas 24 horas, isto indica que percentagem foi administrada através de basais e o que foi dado através do bolus."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Of the total insulin delivered in the past 24 hours, this indicates what percentage was administered through basals and what was given through bolus."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Из общего числа инсулинов, доставленных за последние 24 часа, это указывает на то, какой процент управлялся через базары и что было отдано за счет обмена."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Av det totala insulin som levererats under de senaste 24 timmarna indikerar detta vilken procentandel som administrerades genom basaler och vad som gavs genom bolus."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Of the total insulin delivered in the past 24 hours, this indicates what percentage was administered through basals and what was given through bolus."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Загальний інсулін, що був доставлений за останні 24 години, це показує, який відсоток отримувався через основ і що було подано через болтів."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trong tổng lượng insulin đã được đưa vào cơ thể trong 24 giờ qua, phần này cho biết tỷ lệ phần trăm được cung cấp qua insulin nền (basal) và bao nhiêu được tiêm qua bolus."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在過去 24 小時內所給予的總胰島素中，這表示通過基礎給予和通過注射給予的百分比。"
          }
        }
      }
