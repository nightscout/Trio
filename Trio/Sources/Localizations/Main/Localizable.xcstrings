    "Autosens will begin learning sensitivity anew from the time of the rewind, which may take up to 6 hours." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autosens ще започне да изучава чувствителността наново от момента на презареждане (rewind), което може да отнеме до 6 часа."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autosens se začne znovu učit citlivost od okamžiku převinutí (rewind), což může trvat až 6 hodin."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autosens vil begynde at lære følsomhed på ny fra genvindingstidspunktet, hvilket kan tage op til 6 timer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autosens beginnt die Sensitivität neu zu erlernen, sobald die Gewindestange der Pumpe zurückgespult wurde, was bis zu 6 Stunden dauern kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los autosens comenzarán a aprender la sensibilidad desde el momento del revento, que puede tardar hasta 6 horas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sensibilité automatique \"Autosens\" recommencera l'apprentissage de la sensibilité dès le rembobinage de la pompe, ce qui peut prendre jusqu'à 6 heures."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Autosens will begin learning sensitivity anew from the time of the rewind, which may take up to 6 hours."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autosens inizierà nuovamente l'apprendimento della sensibilità dal momento del riavvolgimento, che può richiedere fino a 6 ore."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Autosens will begin learning sensitivity anew from the time of the rewind, which may take up to 6 hours."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autosens vil begynne å beregne insulinfølsomhet på nytt etter omstart av pumpe, noe som kan ta opptil 6 timer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autosens zal opnieuw de gevoeligheid opnieuw moeten leren vanaf de terugspoeling, die tot 6 uur kan duren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autosens zacznie ponownie uczyć się od czasu wymiany wkłucia/pompy, co może trwać do 6 godzin."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autosens começará de novo a aprender a sensibilidade a partir do tempo do vento, que pode levar até 6 horas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Autosens will begin learning sensitivity anew from the time of the rewind, which may take up to 6 hours."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Автосмены начнут заново изучать чувствительность с момента перемотки, что может занять до 6 часов."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autosens kommer att börja lära sig känslighet på nytt från tiden för vinden, vilket kan ta upp till 6 timmar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Autosens will begin learning sensitivity anew from the time of the rewind, which may take up to 6 hours."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Авторани почнуть вивчати чутливість до навчання, з часу вітру, що може зайняти до 6 годин."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autosens sẽ bắt đầu học lại độ nhạy từ thời điểm tua lại, có thể mất tới 6 giờ."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動敏感度將從復位的時刻開始重新學習敏感度，這可能需要長達6小時。"
          }
        }
      }
