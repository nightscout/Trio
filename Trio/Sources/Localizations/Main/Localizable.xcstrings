        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо ваші CGM прочитання нижче низького значення або вище великого значення, ви отримаєте глюкозу сигнал."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu giá trị đường huyết từ Cảm biến đường huyết của bạn thấp hơn mức Thấp hoặc cao hơn mức Cao, bạn sẽ nhận được cảnh báo đường huyết."
