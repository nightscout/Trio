          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если включено, понижает целевой диапазон при обнаружении пониженной чувствительности"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Av som standard. Sänker målglukosvärdet när 'Autosens' upptäcker minskad insulinkänslighet"
          }
        },
        "tr" : {
          "stringUnit" : {
