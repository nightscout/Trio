    "Gradient Purple = As readings approach and exceed above target, they become more purple." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Градиентно лилаво = колкото повече показанията се приближават и надвишават целта, толкова по-лилави стават."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fialový přechod = Jak se hodnoty blíží k horní hranici cíle nebo ji překračují, barva se mění na sytě fialovou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gradient Purple = Som aflæsninger nærmer sig og overstiger over målet, bliver de mere lilla."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gradient Purple = Wenn sich die Messwerte dem Zielwert nähern und ihn überschreiten, werden sie mehr und mehr lila."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gradient Morado = A medida que las lecturas se acercan y superan el objetivo, se vuelven más moradas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dégradé violet = Plus les mesures du taux de glucose se rapprochent ou dépassent la cible haute, plus elles tirent vers le violet."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Gradient Purple = As readings approach and exceed above target, they become more purple."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viola gradiente = Come le letture si avvicinano e superano il bersaglio, diventano più viola."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Gradient Purple = As readings approach and exceed above target, they become more purple."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gradient lilla = Når blodsukkeret nærmer seg og overstiger målet, blir fargen mer lilla."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kleurovergang Paars = Als lezingen benaderen en hoger zijn dan het streefdoel, worden ze paars."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gradient Fiolet = Gdy odczyty zbliżają się i przekraczają cel, stają się bardziej fioletowe."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gradiente Roxo = À medida que as leituras se aproximam e excedem o alvo acima, elas se tornam mais roxas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Gradient Purple = As readings approach and exceed above target, they become more purple."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фиолетовый градиент = По мере приближения чтения и превышения выше цели они становятся более фиолетовыми."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lila gradient = När mätningarna är över mål blir de mer lila."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Gradient Purple = As readings approach and exceed above target, they become more purple."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Градієнт фіолетовий = Коли читання наближається і перевищує ціль, вони стають більш фіолетовими."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tím chuyển sắc = Khi các chỉ số tiến gần và vượt quá mục tiêu, màu sẽ chuyển dần sang tím đậm hơn."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "漸變紫色 = 隨著讀取值接近並超過目標時，顏色變得越來越紫色。"
          }
        }
      }
    },
    "Gradient Red = As readings approach and exceed below target, they gradually become more red." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Градиентно червено = колкото повече показанията се приближават и падат под целта, толкова по-червени стават."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Červený přechod = Jak se hodnoty blíží k dolní hranici cíle nebo pod ni klesají, postupně červenají."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gradient Red = Som aflæsninger nærmer sig og overstiger under målet, bliver de gradvist mere røde."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gradient Rot = Wenn sich die Messwerte dem Zielwert nähern und ihn überschreiten, werden sie allmählich roter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gradiente Rojo = A medida que las lecturas se acercan y superan el objetivo, gradualmente se vuelven más rojas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dégradé rouge = Plus les mesures du taux de glucose se rapprochent ou descendent sous la cible basse, plus elles tirent vers le rouge."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Gradient Red = As readings approach and exceed below target, they gradually become more red."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gradiente Rosso = Con l'avvicinarsi delle letture e superare il bersaglio, diventano gradualmente più rossi."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Gradient Red = As readings approach and exceed below target, they gradually become more red."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gradient rød = Når blodsukkeret nærmer seg og går under målet, blir fargen mer rød."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kleurovergang Red = Als lezingen in de buurt komen en onder het streefdoel overvallen, worden ze langzamerhand rood."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czerwień gradientowa = Gdy odczyty zbliżają się i przekraczają poniżej celu, stopniowo stają się coraz bardziej czerwone."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gradiente Vermelho = Como as leituras se aproximam e excedem o alvo abaixo, eles gradualmente se tornam mais vermelhos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Gradient Red = As readings approach and exceed below target, they gradually become more red."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Градиент Красный = По мере приближения чтения и превышения ниже цели они постепенно становятся более красными."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Röd gradient = När mätningarna är under mål blir de rödare."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Gradient Red = As readings approach and exceed below target, they gradually become more red."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Градієнт червоний = Коли читачі підходять і перевищують ціль, вони поступово стають червонішими."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đỏ chuyển sắc: Khi các giá trị đường huyết gần hoặc thấp hơn mục tiêu, màu sẽ chuyển dần sang đỏ đậm."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "漸變紅色 = 隨著讀取值接近並低於目標時，顏色逐漸變得越來越紅色。"
          }
        }
      }
    },
