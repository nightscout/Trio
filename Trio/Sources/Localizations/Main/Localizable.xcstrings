    "Limits temporary basal rates to this percentage of the current basal rate." : {
      "comment" : "Mini Hint for Current Basal Safety Multiplier",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ограничава временните базални дози до този процент от текущата базална доза."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omezí dočasné bazály na toto procento aktuálního bazálu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begræns midlertidige basale satser til denne procentdel af den nuværende basale sats."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begrenzt die Temporären Basalraten auf diesen Prozentsatz der aktuellen Basalrate."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limita las tasas basales temporales a este porcentaje de la tasa basal actual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limite les débits basaux temporaires à ce pourcentage du débit basal en cours."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Limits temporary basal rates to this percentage of the current basal rate."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limita i tassi basali temporanei a questa percentuale del tasso basale corrente."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Limits temporary basal rates to this percentage of the current basal rate."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begrenser midlertidige basalrater til denne prosentandelen av nåværende basalrate."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
