    "Please wait up to 30 minutes before glucose readings are available!" : {
      "comment" : "Please wait up to 30 minutes before glucose readings are available!",
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Моля, изчакайте до 30 минути, преди да са налични показанията на глюкоза!"
          }
        },
        "cs" : {
          "stringUnit" : {
