        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio har en hjelpsom guide for nybegynnere. Vi anbefaler at du åpner den nå, og følger den mens du fortsetter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio komt met een handige startup handleiding. Wij raden je aan om deze nu te openen en de stappen te volgen zoals beschreven."
          }
