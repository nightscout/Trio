        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche le facteur d’ajustement (AF) actif pour le facteur de sensibilité à l’insuline dynamique (ISF dynamique) en cours, de type logarithmique ou sigmoïde."
