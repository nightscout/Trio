            "state" : "translated",
            "value" : "Disabilitando questa impostazione si potranno comunque utilizzare altri comandi, come Target Temporanei, Aggiungi carboidrati e Avvia/Termina Progamma"
          }
        },
        "ko" : {
          "stringUnit" : {
