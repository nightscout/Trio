    "If you attempt to request a bolus larger than this, the bolus will not be accepted." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ако се опитате да поискате по-голям болус от този, той няма да бъде приет."
