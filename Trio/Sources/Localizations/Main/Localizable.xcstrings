        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il fattore di sensibilità insulinica (ISF) indica quanto un’unità d'insulina abbasserà la glicemia, il che aiuta a calcolare i boli di correzione."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Your insulin sensitivity factor (ISF) indicates how much one unit of insulin will lower your blood glucose. This helps calculate correction boluses."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din insulinfølsomhetsfaktor (ISF) angir hvor mye én enhet med insulin vil senke blodsukkeret ditt. Dette brukes til å beregne korreksjonsdoser."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jouw insuline gevoeligheidsfactor (ISF) geeft aan hoeveel een insuline eenheid uw bloedglucose zal verlagen. Dit helpt om correctie bolussen te berekenen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twój współczynnik wrażliwości na insulinę (ISF) wskazuje, o ile jedna jednostka insuliny obniży poziom glikemii we krwi. Pomaga to obliczyć bolusy korekcyjne."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "new",
