    "If \"Display IOB and COB\" is also enabled, \"IOB\" and \"COB\" will be replaced with the following emojis:" : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ако е активирано и „Показване на IOB и COB“, „IOB“ и „COB“ ще бъдат заменени със следните емоджита:"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud je zapnuto i „Zobrazit IOB a COB“, budou zkratky „IOB“ a „COB“ nahrazeny těmito emoji:"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis \"Display IOB and COB\" også er aktiveret, vil \"IOB\" og \"COB\" blive erstattet med følgende emojis:"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn \"Zeige IOB und COB\" ebenfalls aktiviert ist, werden \"IOB\" und \"COB\" durch folgende Emojis ersetzt:"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si \"Mostrar IOB y COB\" también está habilitado, \"IOB\" y \"COB\" serán reemplazados por los siguientes emojis:"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si le paramètre \"Afficher l’IOB et COB\" est également activé, \"IOB\" et \"COB\" seront remplacés par les émojis suivants :"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If \"Display IOB and COB\" is also enabled, \"IOB\" and \"COB\" will be replaced with the following emojis:"
          }
