    "Authentication requires a device passcode. Please set one in iOS Settings > Face ID & Passcode." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удостоверяването изисква парола на устройството. Моля, задайте такава в iOS Настройки > Face ID и парола."
