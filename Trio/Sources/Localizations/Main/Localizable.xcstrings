    "Enabling Adjust Basal replaces the standard Autosens Ratio calculation with its own Autosens Ratio calculated as such:" : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Активирането на Adjust Basal замества стандартното изчисление на съотношението Autosens със собствено изчисление, което се прави по следния начин:"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapnutí funkce „Upravit bazál“ nahradí standardní výpočet poměru Autosens vlastním výpočtem, který probíhá následovně:"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivering af Adjust Basal erstatter standardberegningen af Autosens nøgletal med sit eget Autosens nøgletal beregnet som sådan:"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durch die Aktivierung von Basalanpassungen wird die standardmäßige Autosens Ratio-Berechnung durch eine eigene, wie folgt berechnete Autosens Ratio ersetzt:"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Habilitar ajuste Basal reemplaza el cálculo estándar de la relación de autosens por su propia relación de autosens calculada como tal:"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activer « Ajuster le Basal » remplace le calcul standard de la sensibilité automatique du \"ratio Autosens\" par un ratio Autosens spécifique, calculé de la manière suivante :"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enabling Adjust Basal replaces the standard Autosens Ratio calculation with its own Autosens Ratio calculated as such:"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abilitando Regola Basale si sostituisce il calcolo del rapporto Autosens standard con il proprio rapporto Autosens calcolato come tale:"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enabling Adjust Basal replaces the standard Autosens Ratio calculation with its own Autosens Ratio calculated as such:"
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivering av \"juster basal\" vil erstatte standard autosens-ratioberegning med en egen autosens-ratio, beregnet som følger:"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inschakelen van Aanpassen Basaal vervangt de standaard Autosens Ratio berekening met zijn eigen Autosens Verhouding:"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włączenie dostosowywania bazy zastępuje standardowe obliczanie współczynnika Autosens na podstawie własnego współczynnika Autosens obliczonego jako taki:"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ativar o ajuste de Basal substitui o cálculo padrão da proporção Autosens com sua própria taxa de Autosens calculada como tal:"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enabling Adjust Basal replaces the standard Autosens Ratio calculation with its own Autosens Ratio calculated as such:"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включение корректировочного базала заменяет стандартный расчет соотношения автодополнений на свое соотношение, рассчитанное как таковое:"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivering av Justera basal ersätter standard Autosens ratio-beräkning med sin egen Autosens ratio beräknad enligt nedan:"
          }
        },
        "tr" : {
          "stringUnit" : {
