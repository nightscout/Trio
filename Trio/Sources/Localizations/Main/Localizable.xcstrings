    "Sensitivity changes from Temp Targets have a built-in minimum of 15%. Even very high Temp Targets cannot reduce insulin delivery below 15% of normal." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Промените в чувствителността от временните цели имат вграден минимум от 15%. Дори много високите временни цели не могат да намалят подаването на инсулин под 15% от нормалното."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Změny citlivosti z dočasných cílů mají nastavené minimum 15 %. Ani velmi vysoké dočasné cíle nemohou snížit podávání inzulínu pod 15 % tvého normálu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Sensitivity changes from Temp Targets have a built-in minimum of 15%. Even very high Temp Targets cannot reduce insulin delivery below 15% of normal."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Sensitivity changes from Temp Targets have a built-in minimum of 15%. Even very high Temp Targets cannot reduce insulin delivery below 15% of normal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Sensitivity changes from Temp Targets have a built-in minimum of 15%. Even very high Temp Targets cannot reduce insulin delivery below 15% of normal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les modifications de sensibilité liées aux Cibles Temporaires comportent un minimum intégré de 15%. Même des Cibles Temporaires très élevées ne peuvent pas réduire la délivrance d'insuline à moins de 15 % de la normale."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Sensitivity changes from Temp Targets have a built-in minimum of 15%. Even very high Temp Targets cannot reduce insulin delivery below 15% of normal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Sensitivity changes from Temp Targets have a built-in minimum of 15%. Even very high Temp Targets cannot reduce insulin delivery below 15% of normal."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Sensitivity changes from Temp Targets have a built-in minimum of 15%. Even very high Temp Targets cannot reduce insulin delivery below 15% of normal."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensitivitetsendringer fra midlertidige mål har et innebygd minimum på 15%. Selv svært høye midlertidige mål kan ikke redusere insulinleveranse til mindre enn 15% av normalen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Sensitivity changes from Temp Targets have a built-in minimum of 15%. Even very high Temp Targets cannot reduce insulin delivery below 15% of normal."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmiany wrażliwości dla celów tymczasowych mają wbudowane minimum 15%. Nawet bardzo wysokie cele tymczasowe nie mogą zmniejszyć podaży insuliny poniżej 15% normy."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Sensitivity changes from Temp Targets have a built-in minimum of 15%. Even very high Temp Targets cannot reduce insulin delivery below 15% of normal."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Sensitivity changes from Temp Targets have a built-in minimum of 15%. Even very high Temp Targets cannot reduce insulin delivery below 15% of normal."
