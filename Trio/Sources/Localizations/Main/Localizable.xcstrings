    "The Autosens Ratio is used to calculate the amount of adjustment needed to basal rates, ISF, and CR." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коефициентът на Autosens се използва за изчисляване на необходимата корекция на базалните дози, ISF и CR."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poměr Autosens se používá k výpočtu míry úpravy bazálních dávek, ISF a sacharidového poměru (CR)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autosens nøgletal anvendes til at beregne størrelsen af den justering, der er nødvendig for basale satser, ISF og CR."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Autosensverhältnis wird zur Berechnung des Anpassungsbedarfs für Basalraten, ISF und CR verwendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La relación Autosens se utiliza para calcular la cantidad de ajuste necesario para las tasas basales, ISF y CR."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sensibilité automatique du ratio \"ratio Autosens\" est utilisé pour calculer l’ajustement nécessaire des débits basaux, du Facteur de Sensibilité à l’Insuline (ISF) et du Ratio Insuline/Glucides (CR)."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The Autosens Ratio is used to calculate the amount of adjustment needed to basal rates, ISF, and CR."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il rapporto Autosens è utilizzato per calcolare l'importo dell'aggiustamento necessario ai tassi basali, ISF e CR."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The Autosens Ratio is used to calculate the amount of adjustment needed to basal rates, ISF, and CR."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autosens ratio brukes til å beregne hvor mye justering som er nødvendig for basalrater, ISF og CR."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De Autosens Ratio wordt gebruikt om de aanpassing te berekenen die nodig is voor de basaalsnelheden, ISF en CR."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Współczynnik Autosens jest wykorzystywany do obliczenia wielkości korekty potrzebnej do bazowych dawek, ISF i CR."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A relação Autosens é utilizada para calcular o montante de ajustamento necessário às taxas basais, ISF e CR."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The Autosens Ratio is used to calculate the amount of adjustment needed to basal rates, ISF, and CR."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для расчета величины корректировки, необходимой базовым ставкам, ISF и CR, используется коэффициент автоопределения соотношения."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autosens-ration används för att beräkna vilken justering som behövs för basal, ISF och CR."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The Autosens Ratio is used to calculate the amount of adjustment needed to basal rates, ISF, and CR."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обчислення аутенса використовується для обчислення кількості коригування, необхідного для базових курсів, провайдера та CR."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tỉ lệ Autosens được dùng để tính toán mức điều chỉnh cần thiết cho liều nền (basal), độ nhạy insulin (ISF), và tỷ lệ carb (CR)."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動敏感度比率用於計算基礎胰島素率、胰島素敏感度因子 (ISF) 和碳水化合物比率 (CR) 所需的調整量。"
          }
        }
      }
    },
    "The average glucose level around which values will oscillate." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Средното ниво на глюкоза, около което стойностите ще се колебаят."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Průměrná hladina glukózy, kolem které budou hodnoty kolísat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det gennemsnitlige glukoseniveau omkring hvilke værdier vil oscillate."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der durchschnittliche Glukosespiegel, um den die Werte schwanken."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El nivel medio de glucosa alrededor del cual oscillan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le niveau moyen de glucose autour duquel les valeurs vont osciller."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The average glucose level around which values will oscillate."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il livello medio di glucosio attorno al quale oscilleranno i valori."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The average glucose level around which values will oscillate."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gjennomsnittlig blodsukkernivå som verdiene vil svinge rundt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het gemiddelde glucosegehalte om welke waarden gaan oscilleren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Średni poziom glikemii, wokół którego wartości będą się oscylować."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O nível médio de glicose em torno do qual os valores oscilam."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The average glucose level around which values will oscillate."
          }
        },
        "ru" : {
          "stringUnit" : {
