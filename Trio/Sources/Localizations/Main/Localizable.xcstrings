          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het uitschakelen van deze instelling zal andere commando's toestaan, zoals tijdelijke streefdoelen, toevoegen van koolhydraten en Start/Eind overschrijvingen"
          }
        },
        "pl" : {
          "stringUnit" : {
