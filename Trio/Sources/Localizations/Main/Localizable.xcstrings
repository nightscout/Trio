    "Authorize Trio to send notifications and use Bluetooth. You must allow both for Trio to work properly." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешете на Trio да изпраща известия и да използва Bluetooth. Трябва да разрешите и двете, за да работи Trio правилно."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorizuj Trio k zasílání oznámení a používání Bluetooth. Pro správné fungování Tria musíš povolit obojí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillad Trip at sende notifikationer og bruge Bluetooth. Du skal tillade begge for at Trio kan fungere korrekt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube Trio die Verwendung von Bluetooth und dir Benachrichtigungen zu senden. Du musst beides erlauben, damit Trio richtig funktioniert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Authorize Trio to send notifications and use Bluetooth. You must allow both for Trio to work properly."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorise les notifications et la connexion Bluetooth, nécessaires au bon fonctionnement de l’application."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Authorize Trio to send notifications and use Bluetooth. You must allow both for Trio to work properly."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorizza Trio a inviare notifiche e utilizzare Bluetooth. È necessario consentire entrambi per far funzionare correttamente Trio."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Authorize Trio to send notifications and use Bluetooth. You must allow both for Trio to work properly."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillat at Trio sender varslinger og bruker Bluetooth. Du må tillate begge for at Trio skal fungere ordentlig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sta Trio toe om notificaties te sturen en Bluetooth te gebruiken. Beiden zijn nodig om Trio goed te laten werken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozwól Trio na wysyłanie powiadomień i korzystanie z Bluetooth. Musisz zezwolić na obie te czynności, aby Trio działało prawidłowo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Authorize Trio to send notifications and use Bluetooth. You must allow both for Trio to work properly."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Authorize Trio to send notifications and use Bluetooth. You must allow both for Trio to work properly."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Authorize Trio to send notifications and use Bluetooth. You must allow both for Trio to work properly."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auktorisera Trio att skicka notiser och använda Bluetooth. Du måste tillåta båda för att Trio ska fungera korrekt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Authorize Trio to send notifications and use Bluetooth. You must allow both for Trio to work properly."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Authorize Trio to send notifications and use Bluetooth. You must allow both for Trio to work properly."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cho phép Trio gửi thông báo và sử dụng Bluetooth. Bạn phải cho phép cả hai để Trio hoạt động bình thường."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "授權 Trio 發送通知並使用藍牙。您必須同時允許兩者才能使 Trio 正常運作。"
          }
