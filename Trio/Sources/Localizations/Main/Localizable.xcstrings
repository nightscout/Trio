    "Live Activities must be enabled under iOS Settings to allow Trio to display live data." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live Activities трябва да бъдат активирани в настройките на iOS, за да може Trio да показва данни на живо."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
