            "value" : "Indicates when insulin delivery was paused, i.e. pump is suspended."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Указывает, когда приостановка поставки инсулина, то есть насос приостановлен."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indikerar när insulinleveransen pausades, dvs pumpen är avstängd."
          }
        },
        "tr" : {
          "stringUnit" : {
