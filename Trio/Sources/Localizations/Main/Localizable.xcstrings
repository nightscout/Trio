        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estado Bluetooth restaurado (APS reiniciado?). Se encontraron periféricos %d , y se conectaron a %@ con el identificador %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "État du Bluetooth restauré (redémarrage du système en boucle fermée (APS) ?). %d périphériques détectés, connexion établie avec %@ (identifiant %@)"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Bluetooth State restored (APS restarted?). Found %d peripherals, and connected to %@ with identifier %@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stato Bluetooth ripristinato (APS riavviato?). Trovato %d periferiche e collegato a %@ con identificatore %@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
