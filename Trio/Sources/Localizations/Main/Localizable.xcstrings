    "• A higher number means you need less insulin for the same amount of carbs" : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• По-голямо число означава, че се нуждаете от по-малко инсулин за същото количество въглехидрати"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Vyšší číslo znamená, že potřebujete méně inzulínu na stejné množství sacharidů"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Et højere tal betyder, at du har brug for mindre insulin til samme mængde kulhydrater"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Eine höhere Zahl bedeutet, dass Du weniger Insulin für die gleiche Menge an Kohlenhydraten benötigst"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "• A higher number means you need less insulin for the same amount of carbs"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Une valeur plus élevée signifie que vous avez besoin de moins d’insuline pour la même quantité de glucides"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מספר גבוה יותר אומר שצריך פחות אינסולין עבור אותה כמות של פחמימות"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Un numero superiore significa che hai bisogno di meno insulina per la stessa quantità di carboidrati"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 수치가 높을 수록 같은 양의 탄수화물에 필요한 인슐린이 적다는 것을 의미합니다"
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Et høyere tall betyr at du trenger mindre insulin for samme mengde karbohydrater"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Een hoger getal betekent dat je minder insuline nodig hebt voor dezelfde hoeveelheid koolhydraten"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Większa liczba oznacza, że ​​potrzebujesz mniej insuliny do tej samej ilości węglowodanów."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "• A higher number means you need less insulin for the same amount of carbs"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "• A higher number means you need less insulin for the same amount of carbs"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "• A higher number means you need less insulin for the same amount of carbs"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Ett högre värde innebär att du behöver mindre insulin för samma mängd kolhydrater"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
