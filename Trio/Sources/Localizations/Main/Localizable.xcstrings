    "The ratio of how sensitive or resistant to insulin you are in the current loop cycle. Baseline = 1.0, Sensitive < 1.0, Resistant > 1.0" : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коефициентът, показващ колко чувствителни или резистентни сте към инсулин в текущия loop цикъл. База = 1.0, Чувствителен < 1.0, Резистентен > 1.0"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poměr toho, jak citlivý nebo rezistentní na inzulín jsi v aktuálním cyklu smyčky. Základ = 1,0, Citlivý < 1,0, Rezistentní > 1,0."
          }
        },
        "da" : {
