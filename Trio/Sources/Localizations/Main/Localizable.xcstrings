            "value" : "Počkej prosím až 30 minut, než budou dostupné hodnoty glukózy!"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vent op til 30 minutter før der er gluokoseaflæsninger tilgængelige!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es kann bis zu 30 Minuten dauern, bis die Glukosemessungen verfügbar sind."
          }
        },
