    "Trio will always display values based on your actual (raw) CGM readings. Smoothing does not change your real values or alerts." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio винаги ще показва стойности въз основа на действителните (необработени) показания на CGM. Изглаждането не променя реалните ви стойности или предупреждения."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio bude vždy zobrazovat hodnoty na základě tvých aktuálních (nezpracovaných) dat z CGM. Vyhlazování nemění tvé skutečné hodnoty ani alarmy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Trio will always display values based on your actual (raw) CGM readings. Smoothing does not change your real values or alerts."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Trio will always display values based on your actual (raw) CGM readings. Smoothing does not change your real values or alerts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Trio will always display values based on your actual (raw) CGM readings. Smoothing does not change your real values or alerts."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio affiche toujours les valeurs basées sur les mesures réelles (brutes) de votre CGM. Le lissage (Smoothing) ne modifie ni vos valeurs réelles ni vos alertes."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Trio will always display values based on your actual (raw) CGM readings. Smoothing does not change your real values or alerts."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Trio will always display values based on your actual (raw) CGM readings. Smoothing does not change your real values or alerts."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Trio will always display values based on your actual (raw) CGM readings. Smoothing does not change your real values or alerts."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio vil alltid vise verdier basert på dine faktiske (raw) CGM-avlesninger. Utjevning endrer ikke de virkelige verdiene eller varslene dine."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Trio will always display values based on your actual (raw) CGM readings. Smoothing does not change your real values or alerts."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio zawsze wyświetla wartości na podstawie rzeczywistych (surowych) odczytów CGM. Wygładzanie nie zmienia rzeczywistych wartości ani alertów."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "new",
