          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetooth-status gjenopprettet (APS restartet?). Funnet %d ennheter, og koblet til %@ med identifikator %@"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herstelde Bluetooth-status (Trio opnieuw opgestart?). %d randapparatuur gevonden en verbonden met %@ met de identificatie %@"
          }
        },
        "pl" : {
          "stringUnit" : {
