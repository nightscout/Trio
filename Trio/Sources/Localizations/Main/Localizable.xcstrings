    "Represents carb equivalent for fat and protein, calculated using the Warsaw Method." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Представлява въглехидратния еквивалент на мазнините и протеина, изчислен по варшавския метод."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Představuje sacharidový ekvivalent pro tuky a bílkoviny, vypočtený pomocí Varšavské metody."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repræsenterer carb ækvivalent for fedt og protein, beregnet ved hjælp af Warszawa-metoden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
