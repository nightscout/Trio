    "You can connect Trio to seamlessly upload and manage your diabetes data on Tidepool." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можете да свържете Trio, за да качвате и управлявате без затруднения данните за диабета си в Tidepool."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio můžeš připojit k plynulému nahrávání a správě svých dat o diabetu na Tidepoolu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan forbinde Trio til problemfrit at uploade og administrere dine diabetes data på Tidepool."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst Trio verbinden, um Deine Diabetesdaten nahtlos in Tidepool hochzuladen und zu verwalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes conectar Trio para subir y administrar tus datos de diabetes en Tidepool."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
