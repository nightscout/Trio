    "Not enough glucose data. You need at least three glucose readings in the last six hours to run the algorithm." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Няма достатъчно данни за глюкоза. Необходими са поне три показания на глюкоза през последните шест часа, за да се изпълни алгоритъмът."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nedostatek dat o glukóze. Ke spuštění algoritmu potřebuješ alespoň tři naměřené hodnoty za posledních šest hodin."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikke nok glukosedata. Du skal bruge mindst tre glukoseaflæsninger i de sidste seks timer for at køre algoritmen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht genügend Glukosedaten. Sie benötigen in den letzten sechs Stunden mindestens drei Glukosemessungen, um den Algorithmus auszuführen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Not enough glucose data. You need at least three glucose readings in the last six hours to run the algorithm."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas assez de valeurs de glucose. L'algorithme nécessite au moins trois mesures sur les six dernières heures pour fonctionner."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Not enough glucose data. You need at least three glucose readings in the last six hours to run the algorithm."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dati glicemici insufficienti. Per eseguire l'algoritmo sono necessarie almeno tre letture glicemiche nelle ultime sei ore."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Not enough glucose data. You need at least three glucose readings in the last six hours to run the algorithm."
