        }
      }
    },
    "It uses the SMB (Super Micro Bolus) algorithm to deliver insulin in small amounts to correct glucose spikes. UAM also works in reverse, reducing or stopping SMBs if glucose levels drop unexpectedly." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Използва алгоритъма SMB (Super Micro Bolus), за да подава малки количества инсулин за коригиране на пикове в глюкозата. UAM работи и в обратна посока — намалява или спира SMB, ако нивата на глюкозата неочаквано спаднат."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "K podávání malých dávek inzulínu pro korekci glykemických špiček využívá algoritmus SMB (supermikrobolus). UAM funguje i obráceně – snižuje nebo zastavuje podávání SMB, pokud hladina cukru nečekaně klesne."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det bruger SMB (Super Micro Bolus) algoritmen til at levere insulin i små mængder til at korrigere glukose pigge. UAM virker også reversibelt, idet det reducerer eller stopper SMB'er, hvis glukoseniveauet falder uventet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es verwendet den SMB-Algorithmus (Super Micro Bolus), um Insulin in kleinen Mengen zur Korrektur von Glukosespitzen zu liefern. UAM funktioniert auch umgekehrt, reduziert oder stoppt SMBs, wenn der Glukosegehalt unerwartet sinkt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utiliza el algoritmo SMB (Super Micro Bolus) para entregar insulina en pequeñas cantidades para corregir los picos de glucosa. UAM también funciona en inversa, reduciendo o parando SMB si los niveles de glucosa caen inesperadamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il utilise l’algorithme SMB (Super Micro Bolus) pour administrer de petites quantités d’insuline afin de corriger les hausses de glucose. UAM fonctionne également en sens inverse, en réduisant ou en interrompant les SMB si le niveau de glucose baisse de manière inattendue."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "It uses the SMB (Super Micro Bolus) algorithm to deliver insulin in small amounts to correct glucose spikes. UAM also works in reverse, reducing or stopping SMBs if glucose levels drop unexpectedly."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilizza l'algoritmo SMB (Super Micro Bolus) per erogare insulina in piccole quantità per correggere i picchi di glucosio. UAM agisce anche per invertire, ridurre o arrestare le piccole e medie imprese se i livelli di glucosio diminuiscono inaspettatamente."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "It uses the SMB (Super Micro Bolus) algorithm to deliver insulin in small amounts to correct glucose spikes. UAM also works in reverse, reducing or stopping SMBs if glucose levels drop unexpectedly."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den bruker SMB (Super Mikro Bolus) for å levere insulin i små mengder for å korrigere blodsukkerstigning. UAM virker også motsatt, ved å senke eller stoppe SMB hvis blodsukkernivået faller uventet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het gebruikt het SMB (Super Micro Bolus) algoritme om in kleine hoeveelheden insuline toe te dienen voor het corrigeren van glucosepieken. UAM werkt ook omgekeerd, verminderen of stoppen met SMB's als de glucosewaardes onverwacht dalen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wykorzystuje algorytm SMB (Super Micro Bolus) do dostarczania insuliny w małych ilościach w celu skorygowania skoków glikemii. UAM działa również zmniejszając lub zatrzymując SMB, jeśli poziom glukozy niespodziewanie spadnie."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ele usa o algoritmo SMB (Super Micro Bolus) para entregar insulina em pequenas quantidades para corrigir espinhos de glicose. O UAM também funciona em sentido inverso, redução ou interrupção de SMBs caso os níveis de glicose caíssem inesperadamente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "It uses the SMB (Super Micro Bolus) algorithm to deliver insulin in small amounts to correct glucose spikes. UAM also works in reverse, reducing or stopping SMBs if glucose levels drop unexpectedly."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Он использует алгоритм SMB (Super Micro Bolus), чтобы доставить инсулин в небольших количествах для исправления шипов глюкозы. УАМ также работает в обратном, сокращении или остановке СМБ, если уровень глюкозы неожиданно снижается."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den använder SMB (Super Micro Bolus) algoritmen för att leverera insulin i små mängder för att korrigera glukosstigningar. UAM fungerar också omvänt, genom att minska eller stoppa SMB om glukosnivåerna sjunker oväntat."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "It uses the SMB (Super Micro Bolus) algorithm to deliver insulin in small amounts to correct glucose spikes. UAM also works in reverse, reducing or stopping SMBs if glucose levels drop unexpectedly."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Використовується алгоритм SMB (Super Micro Bolus) для доставки інсуліну в невеликих кількостях, щоб виправити піки глюкози. UAM також працює реверсивно, зменшуючи чи зупиняючи SMB, якщо рівень глюкози несподівано знижується."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tính năng này sử dụng thuật toán SMB (Super Micro Bolus) để cung cấp insulin từng liều nhỏ nhằm điều chỉnh các đợt tăng đường huyết. UAM cũng hoạt động ngược lại: giảm hoặc dừng SMB khi mức đường huyết giảm bất ngờ."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它使用SMB（超微量注射）演算法來以小量提供胰島素，以修正葡萄糖尖峰。如果葡萄糖水平意外下降，UAM也會以相反方式運作，減少或停止SMB。"
          }
        }
      }
    },
