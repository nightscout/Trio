    "It is not recommended to set Autosens Max above 150% to maintain safe insulin dosing." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не се препоръчва Autosens Max да се задава над 150%, за да се запази безопасното дозиране на инсулин."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kvůli zachování bezpečného dávkování inzulínu se nedoporučuje nastavovat Autosens Max nad 150 %."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
