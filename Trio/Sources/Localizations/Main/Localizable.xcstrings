    "Bluetooth State restored (APS restarted?). Found %d peripherals, and connected to %@ with identifier %@" : {
      "comment" : "Restored state message",
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Състоянието на Bluetooth е възстановено (APS рестартиран?). Открити са %d периферни устройства и е осъществена връзка с %@ с идентификатор %@"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stav Bluetooth byl obnoven (došlo k restartu APS?). Nalezeno %d zařízení a připojeno k %@ s identifikátorem %@."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetooth-tilstand gendannet (APS genstartet?). Fundet %d perifere enheder, og forbundet til %@ med id %@"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetooth-Verbindung wiederhergestellt (APS neu gestartet?). %d Zubehör gefunden und mit %@ mit der Kennung %@ verbunden"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetooth State restored (APS restarted?). Found %d peripherals, and connected to %@ with identifier %@"
