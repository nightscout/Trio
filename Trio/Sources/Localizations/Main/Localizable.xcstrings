          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detta är en säkerhetsbegränsning för att undvika höga SMB-doser när glukos stiger onormalt snabbt, såsom efter en måltid eller med en \"hoppig\" CGM-sensor."
