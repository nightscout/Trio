          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Før du starter…"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevor Du beginnst…"
          }
        },
