          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This difference exists because situations like exercise often need a much larger insulin reduction than Autosens would detect during a normal daily routine."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sự khác biệt này tồn tại vì các tình huống như tập luyện thường cần giảm insulin nhiều hơn đáng kể so với mức mà Autosens có thể phát hiện trong thói quen hằng ngày bình thường."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "之所以有這樣的差異，是因為像運動這類情境，往往需要比自動敏感度調整在一般日常狀態下所偵測到的更大幅度的胰島素降低。"
          }
        }
      }
    },
