    },
    "Defaults to false. When true, enables supermicrobolus (SMB) for 6h after carbs, even with 0 carbs on board (COB)." : {
      "comment" : "\"Enable SMB After Carbs\"",
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стойност по подразбиране: false. При true активира supermicrobolus (SMB) за 6 часа след въглехидрати, дори при 0 активни въглехидрати (COB)."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Výchozí hodnota je vypnuto. Pokud je zapnuto, povolí supermicrobolus (SMB) po dobu 6 hodin po sacharidech, a to i při 0 aktivních sacharidech (COB)."
          }
        },
        "da" : {
