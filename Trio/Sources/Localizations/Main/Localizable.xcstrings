    "Maximum allowed positive percent change in glucose level to permit SMBs. If the difference in glucose is greater than this, Trio will only adjust Temp Basal Rate and not deliver an SMB that loop cycle." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Максимално допустима положителна процентна промяна в нивото на глюкозата, при която се разрешават SMB. Ако разликата в глюкозата е по-голяма от тази, Trio ще коригира само временния базал и няма да подаде SMB през този цикъл."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximální povolená kladná procentuální změna hladiny glykémie pro povolení SMB. Pokud je rozdíl v glykémii větší než tento limit, Trio v daném cyklu smyčky pouze upraví dočasnou bazální dávku a nepodá SMB."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maksimalt tilladt positiv procentvis ændring i glukoseniveau for at tillade SMB'er. Hvis forskellen i glucose er større end dette, vil Trio kun justere Temp Basal Rate og ikke levere en SMB denne loop cyklus."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximal zulässige positive prozentuale Änderung des Glukosespiegels, um SMBs zu ermöglichen. Wenn der Glukoseunterschied größer als dieser Wert ist, passt Trio nur die Basalrate an und liefert in diesem Loop keinen SMB."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Maximum allowed positive percent change in glucose level to permit SMBs. If the difference in glucose is greater than this, Trio will only adjust Temp Basal Rate and not deliver an SMB that loop cycle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pourcentage maximal d'augmentation du taux de glucose autorisé pour permettre l’administration des SMB. Si la différence de glucose dépasse cette valeur, Trio ajustera uniquement le débit basal temporaire et n’administrera pas de SMB durant ce cycle de boucle."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Maximum allowed positive percent change in glucose level to permit SMBs. If the difference in glucose is greater than this, Trio will only adjust Temp Basal Rate and not deliver an SMB that loop cycle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Maximum allowed positive percent change in glucose level to permit SMBs. If the difference in glucose is greater than this, Trio will only adjust Temp Basal Rate and not deliver an SMB that loop cycle."
          }
        },
        "ko" : {
