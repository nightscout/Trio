    "The Adjustment Factor (AF) allows you to control how quickly and effectively Dynamic ISF responds to changes in glucose levels." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коригиращият коефициент (AF) ви позволява да контролирате колко бързо и ефективно Dynamic ISF реагира на промени в нивата на глюкозата."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faktor úpravy (AF) ti umožňuje kontrolovat, jak rychle a efektivně bude dynamický ISF reagovat na změny glykémie."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Justeringsfaktoren (AF) giver dig mulighed for at kontrollere, hvor hurtigt og effektivt Dynamic ISF reagerer på ændringer i glukoseniveauet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit dem Anpassungsfaktor (AF) kannst Du steuern, wie schnell und effektiv Dynamic ISF auf Änderungen des Blutzuckerspiegels reagiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El factor de ajuste (AF) te permite controlar con qué rapidez y eficacia responde el ISF dinámico a los cambios en los niveles de glucosa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le facteur d’ajustement (AF) permet de contrôler la rapidité et l’efficacité avec lesquelles le Facteur de Sensibilité à l’insuline dynamique (ISF dynamique) réagit aux variations de la mesure de glucose."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The Adjustment Factor (AF) allows you to control how quickly and effectively Dynamic ISF responds to changes in glucose levels."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il fattore di regolazione (AF) consente di controllare quanto velocemente ed efficacemente Dynamic ISF risponde alle variazioni dei livelli di glucosio."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The Adjustment Factor (AF) allows you to control how quickly and effectively Dynamic ISF responds to changes in glucose levels."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med justeringsfaktor (AF) kan du kontrollere hvor raskt og effektivt dynamisk ISF svarer på endringer i blodsukkernivået."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met de aanpassingsfactor (AF) kunt u bepalen hoe snel en effectief het dynamische ISF reageert op veranderingen in glucosewaarden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Współczynnik dostosowania (AF) umożliwia kontrolowanie, jak szybko i skutecznie dynamiczne ISF reaguje na zmiany poziomu glikemii."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Fator de Ajuste (F) permite controlar com que rapidez e eficácia o ISF dinâmico responde às mudanças nos níveis de glicose."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The Adjustment Factor (AF) allows you to control how quickly and effectively Dynamic ISF responds to changes in glucose levels."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коэффициент корректировки (AF) позволяет контролировать то, насколько быстро и эффективно Динамический ISF реагирует на изменения уровней глюкозы."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Justeringsfaktorn (AF) gör att du kan styra hur snabbt och effektivt Dynamisk ISF reagerar på förändringar i glukosnivåer."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The Adjustment Factor (AF) allows you to control how quickly and effectively Dynamic ISF responds to changes in glucose levels."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коефіцієнт регулювання (AF) дозволяє вам контролювати, як швидко і ефективно Динамічний ISF реагує на зміни рівня глюкози."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hệ số điều chỉnh (AF) cho phép bạn kiểm soát mức độ nhanh và hiệu quả mà ISF động phản ứng với sự thay đổi của mức đường huyết."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "調整因子 (AF) 讓您能夠控制動態 ISF 對血糖水平變化的響應速度和有效性。"
          }
        }
      }
    },
    "The app Garmin Connect must be installed to use for Trio.\n Go to App Store to download it" : {
