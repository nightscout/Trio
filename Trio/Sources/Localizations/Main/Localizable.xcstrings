    "Careful tuning is essential to avoid overly aggressive insulin changes." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Внимателното настройване е от съществено значение, за да се избегнат прекалено агресивни промени в подаването на инсулин."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pečlivé vyladění je nezbytné, aby se předešlo příliš agresivním změnám inzulínu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omhyggelig tuning er vigtigt for at undgå alt for aggressive insulinændringer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine sorgfältige Abstimmung ist unerlässlich, um zu aggressive Insulinänderungen zu vermeiden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El ajuste cuidadoso es esencial para evitar cambios de insulina demasiado agresivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un réglage prudent et minutieux est essentiel pour éviter des modifications d'insuline trop agressives."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Careful tuning is essential to avoid overly aggressive insulin changes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una attenta sintonizzazione è essenziale per evitare cambiamenti eccessivamente aggressivi di insulina."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Careful tuning is essential to avoid overly aggressive insulin changes."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nøye justering er nødvendig for å unngå aggressive insulinendringer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voorzichtig afstemmen is essentieel om te veel agressieve insuline-veranderingen te voorkomen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ostrożne dostrojenie jest niezbędne, aby uniknąć zbyt agresywnych zmian w dawkowaniu insuliny."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma afinação cuidadosa é essencial para evitar mudanças de insulina excessivamente agressivas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Careful tuning is essential to avoid overly aggressive insulin changes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Во избежание чрезмерной агрессивной инсулина важно тщательная настройка."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noggrann inställning är viktigt för att undvika alltför aggressiva insulinförändringar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Careful tuning is essential to avoid overly aggressive insulin changes."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ретельне налаштування має важливе значення для уникнення надмірно агресивних змін інсуліну."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cần điều chỉnh cẩn thận để tránh thay đổi insulin quá mạnh."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仔細調整是避免過度激進的胰島素變化所必需的。"
          }
        }
      }
    },
