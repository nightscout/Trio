            "value" : "Uses the very new – first discussed at ATTD 2025 in Amsterdam, NL – Time in Normoglycemia definition, which adopts its range as all values between the normoglycemic minimum threshold (%1$@ %2$@) and %3$@ %4$@."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Uses the very new – first discussed at ATTD 2025 in Amsterdam, NL – Time in Normoglycemia definition, which adopts its range as all values between the normoglycemic minimum threshold (%1$@ %2$@) and %3$@ %4$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Uses the very new – first discussed at ATTD 2025 in Amsterdam, NL – Time in Normoglycemia definition, which adopts its range as all values between the normoglycemic minimum threshold (%1$@ %2$@) and %3$@ %4$@."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Använder den helt nya definitionen – introducerad på ATTD 2025 i Amsterdam, NL – 'Time in Normoglycemia', som avser värden mellan normoglykemisk minimitröskel (%1$@ %2$@) och %3$@ %4$@."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Uses the very new – first discussed at ATTD 2025 in Amsterdam, NL – Time in Normoglycemia definition, which adopts its range as all values between the normoglycemic minimum threshold (%1$@ %2$@) and %3$@ %4$@."
          }
