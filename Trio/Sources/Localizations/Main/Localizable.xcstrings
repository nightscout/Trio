    "All entries you made during Onboarding will be saved automatically when you complete the wizard." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всички данни, въведени по време на началната настройка, ще бъдат запазени автоматично при завършване на съветника."
          }
        },
        "cs" : {
          "stringUnit" : {
