          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz wartość, która pokrywa Twoje najwyższe zapotrzebowanie na insulinę — pomyśl o korekcie na bardzo wysoki odczyt glikemii plus Twój największy bolus posiłkowy. Daje to Trio pole do działania, jednocześnie zapewniając Ci bezpieczeństwo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
