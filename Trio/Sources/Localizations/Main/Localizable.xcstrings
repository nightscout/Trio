    "Biometric authentication is locked due to multiple failed attempts. Please unlock your device using your passcode." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Биометричното удостоверяване е заключено поради няколко неуспешни опита. Моля, отключете устройството си с код за достъп."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
