            "value" : "Enabling SMB Always will disable some of the subsequent \"Enable SMB\" options during Onboarding. These redundant options will be skipped."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enabling SMB Always will disable some of the subsequent \"Enable SMB\" options during Onboarding. These redundant options will be skipped."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du aktiverer \"SMB Alltid\" vil noen av de påfølgende valgene for SMB bli overflødige. Oppstartsveiledningen vil hoppe over disse valgene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het inschakelen van \"SMB Altijd\" zal sommige van de volgende \"SMB inschakelen\" opties tijdens Onboarding uitschakelen. Deze overbodige opties zullen worden overgeslagen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włączenie \"SMB zawsze\" wyłączy niektóre z kolejnych opcji SMB. Pominięte opcje nie zostaną wyświetlone."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enabling SMB Always will disable some of the subsequent \"Enable SMB\" options during Onboarding. These redundant options will be skipped."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enabling SMB Always will disable some of the subsequent \"Enable SMB\" options during Onboarding. These redundant options will be skipped."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enabling SMB Always will disable some of the subsequent \"Enable SMB\" options during Onboarding. These redundant options will be skipped."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivering av \"Använd alltid SMB\" kommer att inaktivera några av de efterföljande \"Aktivera SMB\"-alternativen under onboardingen. Dessa överflödiga alternativ kommer att hoppas över."
          }
        },
        "tr" : {
