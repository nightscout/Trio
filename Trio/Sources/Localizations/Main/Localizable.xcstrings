    "Normally glucose is colored red only when over or under your notification limits for high/low" : {
      "comment" : "UI/UX option",
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обикновено глюкозата се оцветява в червено само когато е над или под лимитите ви за известия за висока/ниска стойност"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glykémie se standardně barví červeně, jen když je nad nebo pod tvými limity pro oznámení vysoké/nízké hodnoty"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normalt er glukose kun farvet rødt, når over eller under din anmeldelse grænser for høj/lav"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normalerweise ist die Glukose nur dann rot, wenn sie über oder unter Deinen Benachrichtigungsgrenzen für hohe/niedrige"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normally glucose is colored red only when over or under your notification limits for high/low"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normalmente la glucosa es de color rojo sólo cuando está por encima o debajo de sus límites de notificación para alto/bajo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normalement, la mesure de glucose n’est colorée en rouge que lorsqu’elle dépasse la limite de notification haute ou basse"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Normally glucose is colored red only when over or under your notification limits for high/low"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normalmente il glucosio è colorato rosso solo quando sopra o sotto i limiti di notifica per alto/basso"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Normally glucose is colored red only when over or under your notification limits for high/low"
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vanligvis er blodsukkeret farget rødt når det er over eller under dine terskler for varsling av høyt/lavt"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normaal gesproken wordt glucose alleen rood gekleurd als je de notificatiegrens hebt overschreden voor hoog/laag"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwykle poziom glikemii jest czerwony tylko wtedy, gdy przekracza lub jest poniżej limitów powiadamiania o wysokim/niskim poziomie glukozy"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normalmente a glicose é colorida somente quando terminar ou abaixo dos seus limites de notificação para alta/baixa"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Normally glucose is colored red only when over or under your notification limits for high/low"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обычно глюкоза окрашивается в красный цвет только в том случае, если значение превышено или выходит за пределы ваших лимитов уведомлений о высоком / низком уровне"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normalt färgläggs aktuellt glukosvärde med rött endast när detta är under eller över dina inställningar för ett lågt eller högt blodsocker i dina notisinställningar"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Normally glucose is colored red only when over or under your notification limits for high/low"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зазвичай рівень глюкози забарвлюється в червоний колір лише тоді, коли рівень сповіщень перевищує або перебуває нижче для високого/низького рівня"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thông thường, đường huyết chỉ được hiển thị màu đỏ khi vượt quá hoặc thấp hơn giới hạn cảnh báo cao/thấp của bạn"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通常只有當血糖超過或低於你的高/低通知限制時，血糖會顯示為紅色"
          }
        }
      }
    },
