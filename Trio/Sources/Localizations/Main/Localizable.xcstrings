        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déclenche une boîte de confirmation si vous tentez d’administrer un bolus lorsque la mesure de glucose est < %1$@ %2$@."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Triggers a confirmation dialog if you attempt to bolus when glucose is < %1$@ %2$@."
          }
        },
        "it" : {
