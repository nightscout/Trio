    },
    "Defaults to false. When true, will lower BG target when autosens detects resistance" : {
      "comment" : "”Resistance Lowers Target\"",
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стойност по подразбиране: false. При true понижава целта за кръвна захар, когато Autosens установи резистентност"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Výchozí hodnota je vypnuta. Pokud je tato volba zapnuta, sníží cílovou glykémii, když Autosens detekuje rezistenci"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standard er falsk. Når sand, vil sænke BG mål, når autosens detekterer modstand"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standardmäßig ausgeschaltet. Wenn aktiviert, wird das Glukoseziel herabgesetzt, sobald Autosens eine Resistenz erkennt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Defaults to false. When true, will lower BG target when autosens detects resistance"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por defecto es falso. Cuando es verdadero, reducirá el objetivo BG cuando detecte resistencia"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Par défaut, cette option est désactivée. Lorsqu’elle est activée, elle abaisse la Cible de glucose lorsque la sensibilité automatique (Autosens) détecte une résistance"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Defaults to false. When true, will lower BG target when autosens detects resistance"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I valori predefiniti sono falsi. Quando VERO, abbasserà il target glicemico quando autosensibilità rileva resistenza insulinica"
          }
        },
        "ko" : {
