    "SMB (Super Micro Bolus) is an oref algorithm feature that delivers small frequent boluses instead of temporary basals for faster glucose control." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SMB (Super Micro Bolus) е функция на алгоритъма oref, която подава малки чести болуси вместо временни базали за по-бърз контрол на глюкозата."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SMB (Super Micro Bolus) je funkce oref algoritmu, která podává malé, časté bolusy namísto dočasných bazálů pro rychlejší kontrolu tvé glykémie."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SMB (Super Micro Bolus) er en oref algoritme funktion, der leverer små hyppige bolusser i stedet for midlertidige basaler for hurtigere glukose kontrol."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SMB (Super Micro Bolus) ist eine Funktion des Oref-Algorithmus, die kleine, häufige Boli anstelle von Temporären Basalraten abgibt, um eine schnellere Blutzuckerkontrolle zu ermöglichen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "SMB (Super Micro Bolus) is an oref algorithm feature that delivers small frequent boluses instead of temporary basals for faster glucose control."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les SMB (Super Micro Bolus) sont une fonctionnalité de l’algorithme \"Oref\" qui administre de petits bolus fréquents à la place des débits basaux temporaires, pour un contrôle plus rapide du glucose."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "SMB (Super Micro Bolus) is an oref algorithm feature that delivers small frequent boluses instead of temporary basals for faster glucose control."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "SMB (Super Micro Bolus) is an oref algorithm feature that delivers small frequent boluses instead of temporary basals for faster glucose control."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "SMB (Super Micro Bolus) is an oref algorithm feature that delivers small frequent boluses instead of temporary basals for faster glucose control."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SMB (Super Mikro Bolus) er en funksjon i Oref-algoritmen som leverer små, hyppige bolusdoser i stedet for midlertidige basalrater. Dette gir raskere regulering av blodsukkeret."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SMB (Super Micro Bolus) is een oref algoritme functie dat kleine frequente bolussen afgeeft in plaats van tijdelijke basalen voor snellere/betere glucose controle."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SMB (Super Micro Bolus) jest funkcją algorytmu Oref, która dostarcza małe, częste bolusy zamiast tymczasowej bazy dla szybszej kontroli glikemii."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "SMB (Super Micro Bolus) is an oref algorithm feature that delivers small frequent boluses instead of temporary basals for faster glucose control."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "SMB (Super Micro Bolus) is an oref algorithm feature that delivers small frequent boluses instead of temporary basals for faster glucose control."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "SMB (Super Micro Bolus) is an oref algorithm feature that delivers small frequent boluses instead of temporary basals for faster glucose control."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SMB (Supermikrobolus) är en funktion i oref-algoritmen som ger små frekventa bolusar istället för tillfälliga basaler för snabbare glukoskontroll."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "SMB (Super Micro Bolus) is an oref algorithm feature that delivers small frequent boluses instead of temporary basals for faster glucose control."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "SMB (Super Micro Bolus) is an oref algorithm feature that delivers small frequent boluses instead of temporary basals for faster glucose control."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SMB (Super Micro Bolus) là một tính năng của thuật toán oref, cho phép tiêm các liều bolus nhỏ và thường xuyên thay vì sử dụng liều nền tạm thời, nhằm kiểm soát đường huyết nhanh hơn."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SMB (超微量注射) 是一種 oref 演算法功能，提供小而頻繁的注射，而不是臨時基礎，以便更快地控制血糖。"
          }
        }
      }
