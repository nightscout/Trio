    "Even if you’re an updating user, you’ll be guided through the algorithm settings configuration step-by-step." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дори и да сте съществуващ потребител, ще бъдете преведени стъпка по стъпка през конфигурирането на настройките на алгоритъма."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I když jsi aktualizující uživatel, provedeme tě nastavením algoritmu krok za krokem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selv hvis du er en opdatering bruger, vil du blive vejledt gennem algoritmes indstillinger og konfiguration trin-for-trin."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
