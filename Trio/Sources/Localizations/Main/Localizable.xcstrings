    "Adjust these values if you would like the statistics to reflect different values than the internationally accepted Time In Range values used as the default." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Променете тези стойности, ако искате статистиката да отразява различни стойности от международно приетите по подразбиране стойности за Време в целевия диапазон."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tyto hodnoty uprav, pokud chceš, aby statistiky odrážely jiné hodnoty než mezinárodně uznávaný Čas v rozmezí (Time In Range), který se používá jako výchozí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Juster disse værdier, hvis du gerne vil have statistikken til at afspejle andre værdier end de internationalt accepterede Time In Range værdier, der anvendes som standard."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passen Sie diese Werte an, wenn Sie möchten, dass die Statistiken andere Werte als die international akzeptierten Werte der \"Zeit im Zielbereich\" widerspiegeln, die als Standard verwendet werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajuste estos valores si desea que las estadísticas reflejen diferentes valores que los valores de intervalo de tiempo aceptados internacionalmente utilizados como valor predeterminado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajustez ces valeurs si vous souhaitez que les statistiques reflètent des valeurs différentes de celles acceptées internationalement dans l'intervalle de temps utilisés par défaut."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Adjust these values if you would like the statistics to reflect different values than the internationally accepted Time In Range values used as the default."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regolare questi valori se si desidera che le statistiche riflettano valori diversi da quelli accettati a livello internazionale per i valori di Time In Range usati come predefiniti."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Adjust these values if you would like the statistics to reflect different values than the internationally accepted Time In Range values used as the default."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Juster disse verdiene hvis du vil at statistikken skal gjenspeile andre verdier enn det som er internasjonalt anerkjent som standardverdier for tid i målområdet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas deze waarden aan als u wilt dat de statistieken verschillende waarden weerspiegelen dan de internationaal geaccepteerde Tijd In Bereik waarden gebruikt worden als standaard."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostosuj te wartości, jeśli chcesz aby statystyki odzwierciedlały inne wartości niż międzynarodowo akceptowane wartości Czasu w zakresie używane jako domyślne."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajuste esses valores se você quiser que as estatísticas reflitam valores diferentes dos valores aceitos internacionalmente em Time In Range usados como padrão."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Adjust these values if you would like the statistics to reflect different values than the internationally accepted Time In Range values used as the default."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отрегулируйте эти значения, если вы хотите, чтобы статистика отражала значения, отличные от международно принятых значений времени в диапазоне, используемых в качестве значений по умолчанию."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Justera dessa värden om du vill att statistiken ska återspegla andra värden än de internationellt accepterade tidsintervallvärdena som används som standard."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Adjust these values if you would like the statistics to reflect different values than the internationally accepted Time In Range values used as the default."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Регулювати ці значення, якщо ви хочете, щоб статистика відображала різні значення, ніж міжнародно прийнятий час у радіусі значення, які використовуються за замовчуванням."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Điều chỉnh các giá trị này nếu bạn muốn thống kê phản ánh các ngưỡng khác với các giá trị Thời gian Trong Phạm Vi (Time In Range) mặc định theo chuẩn quốc tế."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果您希望統計資料反映與國際接受的預設用範的時間範圍值不同的數值，請調整這些值。"
          }
        }
      }
    },
    "Adjusting this value not only can adjust how quickly your sensitivity will respond to changing glucose readings, but also at what glucose readings you reach your Autosens Max/Min limits." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Промяната на тази стойност влияе не само върху скоростта, с която чувствителността ви реагира на променящите се стойности на глюкозата, но и върху това при кои стойности на глюкозата достигате лимитите Autosens Max/Min."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Úprava této hodnoty změní nejen to, jak rychle bude tvá citlivost reagovat na měnící se hladinu glykémie, ale také to, při jakých hodnotách glykémie dosáhneš svých limitů Autosens Max/Min."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Justering af denne værdi vil ikke kun justere, hvor hurtigt din følsomhed vil reagere på ændring af glukoseværdier men også på hvilke glukoseværdier du når dine Autosens Max/Min grænser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Anpassung dieses Wertes kann nicht nur einstellen, wie schnell Deine Empfindlichkeit auf veränderte Glukosewerte reagieren wird, sondern auch bei welchen Glukose-Messungen Du Deine Autosens Max/Min Limits erreichst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajustar este valor no sólo puede ajustar la rapidez con la que tu sensibilidad responderá al cambio de lecturas de glucosa, pero también en qué lecturas de glucosa usted alcanza sus límites Autosens Max/Min."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajuster cette valeur peut non seulement modifier la rapidité avec laquelle votre sensibilité réagit aux variations des mesures de glucose, mais aussi les mesures de glucose auxquelles les limites minimale et maximale de la détection automatique de la sensibilité (Autosens) seront atteintes."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Adjusting this value not only can adjust how quickly your sensitivity will respond to changing glucose readings, but also at what glucose readings you reach your Autosens Max/Min limits."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regolare questo valore non solo può regolare la velocità con cui la tua sensibilità risponderà alle variazioni delle letture di glucosio, ma anche a quali letture di glucosio raggiungete i limiti di Autosens Max/Min."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Adjusting this value not only can adjust how quickly your sensitivity will respond to changing glucose readings, but also at what glucose readings you reach your Autosens Max/Min limits."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ved å endre denne verdien endrer du hvor raskt insulinfølsomheten justeres når blodsukkeret endres. Du endrer også når dine Autosens maks/min-begrensninger blir nådd."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het aanpassen van deze waarde kan niet alleen aanpassen hoe snel uw gevoeligheid reageert op het wijzigen van glucosewaardes maar ook op welke glucose uitlezingen u uw Autosens Max/Min limieten bereikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmiana tej wartości nie tylko pozwala dostosować szybkość reakcji czułości na zmieniające się odczyty poziomu glukozy, ale także to, przy jakich odczytach poziomu glukozy osiągniesz maksymalne/minimalne limity Autosens."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajustar este valor não só pode ajustar a rapidez com que sua sensibilidade responderá à alteração de leituras de glicose, mas também em que leituras de glicose você atinge seus limites Máximos de Autosens."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Adjusting this value not only can adjust how quickly your sensitivity will respond to changing glucose readings, but also at what glucose readings you reach your Autosens Max/Min limits."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Регулирование этого значения не только может быстро настроить насколько быстро ваша чувствительность будет реагировать на изменение показателей глюкозы, но и на каких показаниях глюкозы вы достигнете пределов Autosens Max/Min."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Justera detta värde inte bara kan justera hur snabbt din känslighet kommer att svara på ändrade glukosavläsningar, men också vid vilka glukosvärden du når dina Autosens Max/Min gränser."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Adjusting this value not only can adjust how quickly your sensitivity will respond to changing glucose readings, but also at what glucose readings you reach your Autosens Max/Min limits."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Регулювання цього значення не тільки може налаштувати, як швидко ваша чутливість реагуватиме на зміну читання глюкози, але також в тому, яку глюкозу читаєте ваші автошляхи обмеження макс./мін."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Điều chỉnh giá trị này không chỉ ảnh hưởng đến tốc độ phản ứng của độ nhạy insulin trước các thay đổi của đường huyết, mà còn ảnh hưởng đến mức đường huyết tại đó bạn đạt tới các giới hạn Tối đa/Tối thiểu của Autosens."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "調整這個數值不僅可以改變您的敏感度對變化的血糖讀取值反應的快慢，也會影響您何時達到 Autosens 的最大/最小限制。"
          }
        }
      }
    },
