    "Note: This setting is only utilized if the settings \"Low Temp Target Lowers Sensitivity\" OR \"High Temp Target Raises Sensitivity\" are enabled." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Забележка: Тази настройка се използва само ако са включени настройките „Low Temp Target Lowers Sensitivity“ ИЛИ „High Temp Target Raises Sensitivity“."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poznámka: Toto nastavení se využije pouze tehdy, pokud je zapnuto nastavení „Nízký dočasný cíl snižuje citlivost“ NEBO „Vysoký dočasný cíl zvyšuje citlivost“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bemærk: Denne indstilling bruges kun, hvis indstillingerne \"Lav Temp Mål Sænker Følsomhed\" ELLER \"Høj Temp Mål Hæver Følsomhed\" er aktiveret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hinweis: Diese Einstellung wird nur verwendet, wenn \"Niedriges Temporäres Ziel senkt Empfindlichkeit\" ODER \"Hohes Temporäres Ziel erhöht Empfindlichkeit\" aktiviert sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nota: Esta opción sólo se utiliza si la configuración \"Bajo Objetivo Temp Bajar Sensitividad\" o \"Alto Objetivo Temp Aumenta la Sensibilidad\"."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
