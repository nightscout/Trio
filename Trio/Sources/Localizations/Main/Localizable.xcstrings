    "Glucose trace WILL NOT be affected by any insulin or carb entries." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кривата на глюкозата НЯМА да бъде повлияна от записи за инсулин или въглехидрати."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Průběh glukózy NEBUDE ovlivněn žádnými záznamy inzulínu nebo sacharidů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
