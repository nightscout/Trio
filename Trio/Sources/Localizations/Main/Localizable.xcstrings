    "There are also options to override your Max SMB Minutes and Max UAM SMB Minutes, as well as to disable SMBs." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Има също опции за отмяна на вашите Max SMB Minutes и Max UAM SMB Minutes, както и за изключване на SMB."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Existují také možnosti, jak přepsat tvé limity Max SMB minut a Max UAM SMB minut, a také možnost SMB úplně vypnout."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der er også muligheder for at tilsidesætte din Max SMB Minutter og Max UAM SMB Minutes, samt at deaktivere SMB'er."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es gibt auch Optionen, Deine Max SMB Minuten und Max UAM SMB Minuten zu überschreiben sowie die SMB zu deaktivieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "También hay opciones para anular los minutos máximos de SMB y UAM SMB, así como para desactivar SMBs."
          }
        },
        "fr" : {
          "stringUnit" : {
