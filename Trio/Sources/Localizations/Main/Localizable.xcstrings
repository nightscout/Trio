    "You can use Nightscout to import your existing therapy settings, or if you prefer, you can only connect to Nightscout, and configure therapy settings from scratch." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можете да използвате Nightscout, за да импортирате съществуващите си настройки на терапията, или, ако предпочитате, можете просто да се свържете с Nightscout и да конфигурирате настройките на терапията от нулата."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nightscout můžeš použít k importu svých stávajících nastavení léčby, nebo pokud preferuješ, můžeš se k Nightscoutu jen připojit a nastavit parametry léčby od nuly."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan bruge Nightscout til at importere dine eksisterende terapiindstillinger, eller hvis du foretrækker det, kan du nøjes med at oprette forbindelse til Nightscout, og konfigurere terapiindstillinger fra bunden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst Nightscout verwenden, um Deine bestehenden Therapieeinstellungen zu importieren, oder, wenn Du es vorziehst, kannst Du Dich nur mit Nightscout verbinden und die Therapieeinstellungen von Grund auf neu konfigurieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You can use Nightscout to import your existing therapy settings, or if you prefer, you can only connect to Nightscout, and configure therapy settings from scratch."
          }
