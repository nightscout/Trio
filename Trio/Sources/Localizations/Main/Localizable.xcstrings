          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Длительность действия инсулина (DIA) определяет, как долго ваш инсулин продолжает снижать показатели глюкозы после дозы."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Insulinets verkningstid (DIA) definierar hur länge ditt insulin fortsätter att sänka glukosvärden efter en dos."
          }
        },
