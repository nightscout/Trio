          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold deg i åpen loop (ingen automatisert dosering) en stund slik at Trio kan samle data og holde deg trygg"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blijf in de open loop modus (geen geautomatiseerde dosering) om Trio te helpen je veiligheid te behouden"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozostań w otwartej pętli (bez automatycznego dawkowania) przez chwilę, aby pomóc Trio nadrobić zaległości i zapewnić Ci bezpieczeństwo"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
