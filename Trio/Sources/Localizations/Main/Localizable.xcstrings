    "Trio does not collect any health related data, e.g. glucose readings, insulin rates or doses, meal data, setting values, or similar." : {
      "extractionState" : "stale",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio не събира никакви данни, свързани със здравето, напр. показания на глюкоза, инсулинови скорости или дози, данни за хранене, стойности на настройки или подобни."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio neshromažďuje žádná data související se zdravím, např. hodnoty glykémie, bazální dávky nebo bolusy, údaje o jídle, nastavené hodnoty a podobně."
