    },
    "Enabling this setting allows you to log fat and protein, which are then converted into future carb equivalents using the Warsaw Method." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Активирането на тази настройка ви позволява да записвате мазнини и протеини, които след това се преобразуват в бъдещи еквиваленти на въглехидрати по Варшавския метод."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapnutí tohoto nastavení ti umožní zapisovat tuky a bílkoviny, které se pomocí Varšavské metody převedou na budoucí sacharidové ekvivalenty."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivering af denne indstilling giver dig mulighed for at logge fedt og protein, som derefter konverteres til fremtidige carb ækvivalenter ved hjælp af Warszawa-metoden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Du diese Einstellung aktivierst, kannst Du Fett und Eiweiß protokollieren, die dann nach der Warschauer Methode in zukünftige Kohlenhydratäquivalente umgerechnet werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Habilitar este ajuste le permite registrar grasas y proteínas, que luego se convierten en futuros equivalentes de carbohidratos utilizando el Método de Varsovia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activer ce paramètre vous permet d'enregistrer les lipides et les protéines, qui sont ensuite convertis en équivalents glucidiques futurs en utilisant la méthode de \"Varsaw\"."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enabling this setting allows you to log fat and protein, which are then converted into future carb equivalents using the Warsaw Method."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abilitando questa impostazione è possibile registrare grassi e proteine, che vengono poi convertiti in futuri equivalenti carb utilizzando il Metodo di Varsavia ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enabling this setting allows you to log fat and protein, which are then converted into future carb equivalents using the Warsaw Method."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivering av denne innstillingen lar deg logge fett og proteiner, som så konverteres til fremtidige karbohydratekvivalenter ved hjelp av Warszawa-metoden."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Door deze instelling in te schakelen kunt u vet en eiwitten loggen, die vervolgens worden omgezet in toekomstige koolhydraten equivalenten met behulp van de Warschau methode."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włączenie tego ustawienia umożliwia rejestrowanie tłuszczu i białka, które następnie są przeliczane na przyszłe odpowiedniki węglowodanów za pomocą metody warszawskiej."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Habilitar essa configuração permite que você registre gordura e proteínas, que são convertidas em futuros equivalentes de carb usando o Método de Varsóvia."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enabling this setting allows you to log fat and protein, which are then converted into future carb equivalents using the Warsaw Method."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включение этой настройки позволяет записывать жиры и белки, которые затем конвертируются в будущие эквиваленты карбонов с использованием Варшавского метода."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genom att aktivera denna inställning kan du logga fett och protein, som sedan omvandlas till framtida kolhydrater med hjälp av Warszawa-metoden."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enabling this setting allows you to log fat and protein, which are then converted into future carb equivalents using the Warsaw Method."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Увімкнення цього параметру дозволить вам записувати жир і білки, які потім перетворюються на майбутні барви еквіваленти, використовуючи ортогоналу Варшавської стрії."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bật cài đặt này cho phép bạn ghi lại chất béo và chất đạm, sau đó sẽ được chuyển đổi thành lượng carb tương đương trong tương lai bằng phương pháp Warsaw."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用此設定允許你記錄脂肪和蛋白質，這些會使用華沙方法轉換成未來的碳水化合物當量。"
          }
        }
      }
    },
    "Enabling Unsuspend If No Temp allows Trio to resume your pump if you forget, as long as a zero temp basal was set first. This feature ensures insulin delivery restarts if you forget to manually unsuspend, adding a safeguard for pump reconnections." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Активирането на „Unsuspend If No Temp“ позволява на Trio да възобнови помпата ви, ако забравите, при условие, че първо е бил зададен нулев временен базал. Тази функция гарантира, че подаването на инсулин ще се възобнови, ако забравите ръчно да премахнете паузата, като добавя допълнителна защита при повторна връзка с помпата."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapnutí funkce „Zrušit pozastavení bez dočasného bazálu“ (Unsuspend If No Temp) umožňuje Triu znovu spustit tvou pumpu, pokud zapomeneš, za předpokladu, že byl nejdříve nastaven nulový dočasný bazál. Tato funkce zajišťuje restart podávání inzulínu, pokud zapomeneš manuálně zrušit pozastavení, čímž přidává pojistku pro případy opětovného připojení pumpy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivering Unsuspend Hvis No Temp tillader Trio at genoptage din pumpe, hvis du glemmer, så længe en nul temp basal blev sat først. Denne funktion sikrer, at insulinleveringen genstarter, hvis du glemmer at suspendere manuelt, og tilføjer en sikkerhedsforanstaltning til gentilslutning af pumpen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durch die Aktivierung von „Unsuspend If No Temp“ kann Trio Deine Pumpe wieder in Betrieb nehmen, wenn Du dies vergisst, sofern zuvor eine Basalrate von Null eingestellt wurde. Diese Funktion stellt sicher, dass die Insulinabgabe wieder aufgenommen wird, wenn Du vergessen hast, die Pumpe manuell anzuschalten, und bietet eine zusätzliche Sicherheit für den erneuten Anschluss der Pumpe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Habilitando Dessuspender Si No Temp permite a Trio reanudar su bomba si se falsifica, siempre y cuando se haya establecido una base temporal cero. Esta función asegura que la entrega se reinicie si se olvida de suspender manualmente, añadiendo una salvaguarda para las reconexiones de la bomba."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activer l’option « Annuler la suspension si aucun débit temporaire » (Unsuspend If No Temp) permet à Trio de réactiver votre pompe si vous oubliez de le faire, à condition qu’un débit basal temporaire de 0 ait été défini au préalable. Cette fonctionnalité garantit la reprise de l’administration d’insuline en cas d’oubli de réactivation manuelle, ajoutant ainsi une sécurité lors de la reconnexion de la pompe."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enabling Unsuspend If No Temp allows Trio to resume your pump if you forget, as long as a zero temp basal was set first. This feature ensures insulin delivery restarts if you forget to manually unsuspend, adding a safeguard for pump reconnections."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abilitare la Sospensione Se non c'è Temperatura che permette al Trio di riprendere il microinfusore se si dimentica, finché prima è stata impostata una basale temporanea pari a zero. Questa funzione assicura il riavvio della somministrazione di insulina se dimentica di smettere manualmente, aggiungendo una protezione per le riconnessioni della pompa."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enabling Unsuspend If No Temp allows Trio to resume your pump if you forget, as long as a zero temp basal was set first. This feature ensures insulin delivery restarts if you forget to manually unsuspend, adding a safeguard for pump reconnections."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du aktiverer \"Fjern pause hvis det ikke finnes et midlertidig mål\", kan Trio gjenoppta pumpen hvis du glemmer det, så lenge en midlertidig basalrate på null ble satt først. Denne funksjonen sørger for at insulintilførselen starter på nytt hvis du glemmer å oppheve suspenderingen manuelt, og legger til en beskyttelse for gjentilkobling av pumpen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unsuspend inschakelen als geen tijdelijke opname het mogelijk maakt om Trio te hervatten als je vergeten bent, zolang je eerst een tijdelijk basaal van 0 hebt ingesteld. Deze functie zorgt ervoor dat insulinetoediening opnieuw wordt gestart als je vergeet om handmatig de insuline-verbinding weer uit te schakelen, waardoor een veiligheidsgarantie wordt toegevoegd voor het opnieuw verbinden met de pomp."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włączenie opcji \"Wznów po zawieszeniu\" pozwala Trio wznowić pompę, jeśli zapomnisz, pod warunkiem, że najpierw ustawiono bazę bazową zerowej temperatury. Ta funkcja zapewnia ponowne uruchomienie podawania insuliny, jeśli zapomnisz ręcznie wyłączyć zawieszenie, dodając zabezpieczenie przed ponownym podłączeniem pompy."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Habilitar Dessuspender Se Nenhuma Temp permitir que Trio retome sua bomba se você esquecer, desde que uma basal temporária zero tenha sido definida primeiro. Este recurso garante o reinício da entrega de insulina se você esquecer de dessuspender manualmente, adicionando uma salvaguarda para reconexões da bomba."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enabling Unsuspend If No Temp allows Trio to resume your pump if you forget, as long as a zero temp basal was set first. This feature ensures insulin delivery restarts if you forget to manually unsuspend, adding a safeguard for pump reconnections."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включение Unsuspend Если нет темп позволяет трио возобновить насос, если вы забываете, до нуля температурный базал был установлен первым. Эта функция обеспечивает перезапуск инсулина, если вы забыли вручную разблокировать, добавляя защитные средства для соединения с насосом."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivering av 'Återaktivera om ingen temp basal' tillåter Trio att återuppta din pump om du glömmer, så länge en noll-tempbasal sattes först. Denna funktion garanterar att insulintillförseln återstartas om du glömmer att göra det manuellt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enabling Unsuspend If No Temp allows Trio to resume your pump if you forget, as long as a zero temp basal was set first. This feature ensures insulin delivery restarts if you forget to manually unsuspend, adding a safeguard for pump reconnections."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Увімкнення «Беззупинки», якщо «Немає темпи» дозволяє племені відновити насос, якщо ви забули, до тих пір, поки встановлено нульова умовна версія. Ця функція гарантує повторне надсилання інсулінів, якщо ви забудете закрити її вручну, ненаненадійне додавання захищеного з'єднання для насосу."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bật tùy chọn “Tự động tiếp tục nếu không có liều nền tạm thờil” cho phép Trio tự động nối lại truyền insulin nếu bạn quên, miễn là đã có một liều nền tạm thời bằng 0 được thiết lập trước đó. Tính năng này giúp đảm bảo việc truyền insulin được khôi phục nếu bạn quên bật lại thủ công, tạo thêm lớp bảo vệ khi kết nối lại với bơm."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用無需暫停如果無臨時設定則允許 Trio 恢復開啟幫浦，如果忘記操作，只要先設定為零臨時基礎量。這個功能確保在你忘記手動解除暫停時，胰島素輸送會重新開始，為幫浦重連增加一層保障。"
          }
        }
      }
    },
