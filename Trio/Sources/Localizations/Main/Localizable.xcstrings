    "Trio is a powerful app that helps you manage your diabetes. Let's get started by setting up a few important parameters that will help Trio work effectively for you." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio е мощно приложение, което ви помага да управлявате диабета си. Нека започнем с настройване на няколко важни параметъра, които ще помогнат на Trio да работи ефективно за вас."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio je výkonná aplikace, která ti pomáhá se správou diabetu. Pojďme začít nastavením několika důležitých parametrů, díky kterým pro tebe bude Trio pracovat efektivně."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio er en kraftfuld app, der hjælper dig med at styre din diabetes. Lad os komme i gang med at oprette et par vigtige parametre, der vil hjælpe Trio arbejde effektivt for dig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio ist eine leistungsstarke App, die Dich bei der Kontrolle Deines Diabetes unterstützt. Lasse uns zunächst ein paar wichtige Parameter einstellen, damit Trio effektiv für Dich arbeiten kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Trio is a powerful app that helps you manage your diabetes. Let's get started by setting up a few important parameters that will help Trio work effectively for you."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio est une application avancée conçue pour vous aider à gérer votre diabète. Commençons par configurer quelques-uns de ses réglages importants pour poser les bases d’un bon fonctionnement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Trio is a powerful app that helps you manage your diabetes. Let's get started by setting up a few important parameters that will help Trio work effectively for you."
          }
