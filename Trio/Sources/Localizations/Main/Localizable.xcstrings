          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nó đóng vai trò như một giới hạn an toàn, đảm bảo rằng không có liều insulin nền tạm thời nào vượt quá mức an toàn."
          }
        },
        "zh-Hant" : {
