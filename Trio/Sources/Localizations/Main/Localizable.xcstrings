    "Min 5m Carb Impact sets the expected glucose rise from carbs over 5 minutes when absorption isn't obvious from glucose data." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Min 5m Carb Impact задава очакваното покачване на глюкозата от въглехидрати за 5 минути, когато абсорбцията не е ясна от данните за глюкозата."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Min. 5minutový vliv sacharidů“ nastavuje očekávaný vzestup glykémie ze sacharidů během 5 minut, pokud vstřebávání není patrné z dat o glukóze."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Min 5m Carb Impact indstiller den forventede stigning i glukose fra kulhydrater over 5 minutter, når absorptionen ikke er indlysende fra glukosedata."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Min. 5 m Carb Impact setzt den erwarteten Glukoseanstieg von Kohlenhydraten über 5 Minuten, wenn die Absorption aus den Glukosedaten nicht ersichtlich ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impacto mínimo de 5 m del Carbo establece el aumento esperado de la glucosa de los carbohidratos en 5 minutos cuando la absorción no es obvia de los datos de la glucosa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’Impact glucidique minimal sur 5 minutes définit l’augmentation attendue de la mesure de glucose due aux glucides sur 5 minutes lorsque l’absorption n’est pas clairement visible dans les données de glucose."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Min 5m Carb Impact sets the expected glucose rise from carbs over 5 minutes when absorption isn't obvious from glucose data."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Min 5m Carb Impact imposta l'aumento atteso di glucosio dai carboidrati in 5 minuti quando l'assorbimento non è evidente dai dati relativi al glucosio."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Min 5m Carb Impact sets the expected glucose rise from carbs over 5 minutes when absorption isn't obvious from glucose data."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Min. 5m karbohydratpåvirkning angir forventet glukoseøkning fra karbohydrater over 5 minutter når absorpsjonen ikke er åpenbar fra glukosedata."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Min 5 m koolhydraten Impact stelt de verwachte glucosestijging in vanaf koolhydraten ouder dan 5 minuten wanneer absorptie niet zichtbaar is uit glucosegegevens."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Min. 5-minutowy wpływ węglowodanów określa oczekiwany wzrost glikemii z węglowodanów w ciągu 5 minut, gdy wchłanianie nie jest oczywiste na podstawie danych dotyczących glikemii."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mínimo de 5 metros de impacto Carb define o aumento de glicose esperado dos carbs em 5 minutos quando a absorção não é óbvia a partir dos dados de glicose."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Min 5m Carb Impact sets the expected glucose rise from carbs over 5 minutes when absorption isn't obvious from glucose data."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мин. 5m Влияние Карба устанавливает ожидаемый рост глюкозы от углеводов в течение 5 минут, когда абсорбция неочевидна из-за данных о глюкозах."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'Minsta kolhydratpåverkan på 5 m' sätter den förväntade glukosökningen från kolhydrater över 5 minuter när absorption inte är uppenbart från glukosdata."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Min 5m Carb Impact sets the expected glucose rise from carbs over 5 minutes when absorption isn't obvious from glucose data."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мін. 5м Карб впливає на очікуване підвищення глюкози з карб більше 5 хвилин, коли поглинання не очевидні з даних глюкози."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tác động tối thiểu của carb trong 5 phút (Min 5m Carb Impact) thiết lập mức tăng đường huyết dự kiến từ carbohydrate trong 5 phút, trong trường hợp dữ liệu hấp thụ chưa thể hiện rõ qua số liệu đường huyết."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最少5分鐘碳水影響設定預期在吸收不明顯的情況下，碳水化合物在5分鐘內對葡萄糖的升高影響。"
          }
        }
      }
    },
