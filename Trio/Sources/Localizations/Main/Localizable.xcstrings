    "Remaining Carbs Percentage estimates carbs still absorbing over 4 hours if glucose data doesn't show clear absorption." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Процентът на оставащите въглехидрати оценява колко въглехидрати все още се абсорбират през следващите 4 часа, ако данните за глюкозата не показват ясна абсорбция."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Procento zbývajících sacharidů odhaduje množství sacharidů, které se stále vstřebávají během 4 hodin, pokud data o glukóze neukazují jasné vstřebávání."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resterende kulhydrater Procentdel skønner kulhydrater stadig absorberer over 4 timer, hvis glukosedata ikke viser klar absorption."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Verbleibende Kohlenhydrate Prozentsatz\" schätzt die Kohlenhydrate, die über 4 Stunden noch absorbiert werden, wenn die Glukosedaten keine eindeutige Absorption zeigen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El porcentaje restante de carbohidratos calcula que los glúcidos siguen absorbiendo durante 4 horas si los datos de glucosa no muestran una absorción clara."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le champ \"Pourcentage de glucides restants\" estime les glucides encore en absorption au-delà de 4 heures si les données de glucose ne montrent pas d’absorption claire."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Remaining Carbs Percentage estimates carbs still absorbing over 4 hours if glucose data doesn't show clear absorption."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carboidrati rimanenti La percentuale stima i carboidrati che ancora assorbono più di 4 ore se i dati sul glucosio non mostrano un assorbimento chiaro."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Remaining Carbs Percentage estimates carbs still absorbing over 4 hours if glucose data doesn't show clear absorption."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gjenværende karbohydratprosent anslår at karbohydrater fortsatt absorberes i over 4 timer hvis blodsukkerdataene ikke viser tydelig absorpsjon."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resterende koolhydraten Percentage schat koolhydraten nog steeds meer dan 4 uur als glucose gegevens niet duidelijk geabsorbeerd worden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Procent pozostałych węglowodanów określa szacunkową ilość węglowodanów, które zostaną wchłonięte w ciągu 4 godzin, jeśli dane dotyczące glikemii nie wykażą wyraźnego wchłaniania."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estimativa de porcentagem de carbs restantes de hidratos que ainda absorvem mais de 4 horas se os dados de glicose não mostrarem uma absorção clara."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Remaining Carbs Percentage estimates carbs still absorbing over 4 hours if glucose data doesn't show clear absorption."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оставшиеся углеводы прогнозируют количество углеводов в течение 4 часов, если данные о глюкозе не показывают четкого поглощения."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Återstående kolhydrater i procent uppskattar kolhydrater som fortfarande absorberas över 4 timmar om glukosdata inte visar någon tydlig absorption."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Remaining Carbs Percentage estimates carbs still absorbing over 4 hours if glucose data doesn't show clear absorption."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Процентні оцінки трупів також поглинаються понад 4 години, якщо дані глюкози не показують чіткого поглинання."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Phần trăm carb còn lại” ước tính lượng carb vẫn đang được hấp thu trong vòng 4 giờ nếu dữ liệu đường huyết không cho thấy dấu hiệu hấp thu rõ ràng."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "剩餘碳水化合物百分比估算在葡萄糖資料未顯示明顯吸收的情況下，仍在四小時內吸收的碳水化合物。"
          }
        }
      }
    },
