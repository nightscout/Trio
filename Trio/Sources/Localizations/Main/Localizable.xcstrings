    "Forecasts the worst-case future glucose reading scenario if no carbs are absorbed and insulin delivery is stopped until glucose starts rising." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прогнозира най-лошия възможен сценарий за бъдещите показания на глюкозата, ако не се абсорбират въглехидрати и подаването на инсулин е спряно, докато глюкозата не започне да се покачва."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Předpovídá nejhorší možný scénář budoucí glykémie pro případ, že se nevstřebají žádné sacharidy a podávání inzulínu se zastaví, dokud glykémie nezačne stoupat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prognoser det værst tænkelige fremtidige glukosescenarie, hvis ingen kulhydrater absorberes, og insulindosis stoppes, indtil glukosen begynder at stige."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prognostiziert den ungünstigsten Fall, wenn keine Kohlenhydrate aufgenommen werden und die Insulinausschüttung gestoppt wird, bis die Glukose beginnt zu steigen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Presenta el peor escenario de lectura de glucosa en el futuro si no se absorbe ningún glúcido y se detiene el parto de insulina hasta que la glucosa empiece a aumentar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prévision la plus défavorable des mesures du glucose si aucun glucide n’était absorbé et que l’administration d’insuline était interrompue jusqu’à ce que le glucose recommence à augmenter."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Forecasts the worst-case future glucose reading scenario if no carbs are absorbed and insulin delivery is stopped until glucose starts rising."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prevede lo scenario peggiore di lettura futura del glucosio se non vengono assorbiti carboidrati e la somministrazione di insulina viene interrotta fino a quando il glucosio inizia ad aumentare."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Forecasts the worst-case future glucose reading scenario if no carbs are absorbed and insulin delivery is stopped until glucose starts rising."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beregner verst tenkelig fremtidig blodsukker hvis ingen karbohydrater absorberes og insulintilførsel stoppes inntil blodsukkeret begynner å stige."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voorraadt het ergste geval in het toekomstige glucoseleesscenario als er geen koolhydraten worden opgenomen en de toediening van insuline wordt gestopt totdat glucose begint te stijgen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prognozuje najgorszy scenariusz przyszłych odczytów glikemii, jeśli nie zostaną wchłonięte żadne węglowodany, a podawanie insuliny zostanie przerwane do czasu, aż poziom glikemii zacznie rosnąć."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prevê o cenário de leitura da glicose futura pior se não forem absorvidos e se a entrega da insulina for interrompida até que a glicose comece a subir."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
