    "Trio could not communicate with your pump. Changes to your basal profile were not saved." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio не можа да комуникира с помпата ви. Промените в базалния ви профил не бяха запазени."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Triu se nepodařilo spojit s tvou pumpou. Změny v tvém bazálním profilu nebyly uloženy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio kunne ikke kommunikere med din pumpe. Ændringer i din basalprofil blev ikke gemt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio konnte nicht mit Deiner Pumpe kommunizieren. Änderungen an Deinem Basisprofil wurden nicht gespeichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio no pudo comunicarse con tu bomba. Los cambios en tu perfil basal no se han guardado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio n’a pas pu communiquer avec votre pompe. Les modifications de votre profil basal n’ont pas été enregistrées."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Trio could not communicate with your pump. Changes to your basal profile were not saved."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio non è riuscito a comunicare con la pompa. Le modifiche al tuo profilo basale non sono state salvate."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Trio could not communicate with your pump. Changes to your basal profile were not saved."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio kunne ikke kommunisere med pumpen. Endringer til basalprofilen din ble ikke lagret."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio kon niet communiceren met je pomp. Wijzigingen aan je basaalprofiel zijn niet opgeslagen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio nie może komunikować się z pompą. Zmiany w profilu bazowym nie zostały zapisane."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio não conseguiu se comunicar com sua bomba. Alterações no seu perfil basal não foram salvas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Trio could not communicate with your pump. Changes to your basal profile were not saved."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Трио не смог связаться с вашим насосом. Изменения в вашем базовом профиле не были сохранены."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio kunde inte kommunicera med din pump. Ändringar i din basalprofil sparades inte."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Trio could not communicate with your pump. Changes to your basal profile were not saved."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio не вдалося зв’язатися з вашим насосом. Зміни в базовому профілі не були збережені."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio không thể kết nối với bơm insulin của bạn. Các thay đổi trong Hồ sơ liều nền đã không được lưu."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio 與您的幫浦無法通訊。基礎設定的變更未被儲存。"
          }
        }
      }
    },
