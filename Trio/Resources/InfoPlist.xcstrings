    "NSCalendarsFullAccessUsageDescription" : {
      "comment" : "Privacy - Calendars Full Access Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За създаване на събития със стойности на кръвната захар, за да се виждат в Apple Watch и CarPlay"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vytvářejte události s hodnotami glykémie, aby bylo možné je zobrazit na Apple Watch a v systému CarPlay."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "To create events with glucose values, so they can be viewed on Apple Watch and CarPlay"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ereignisse mit BG-Lese-Werten erstellen, so dass sie bei Apple Watch und CarPlay angezeigt werden können"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "To create events with glucose values, so they can be viewed on Apple Watch and CarPlay"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "To create events with glucose values, so they can be viewed on Apple Watch and CarPlay"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour créer des événements avec les mesures de glucose, afin qu'ils puissent être consultés sur Apple Watch et CarPlay"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "To create events with glucose values, so they can be viewed on Apple Watch and CarPlay"
