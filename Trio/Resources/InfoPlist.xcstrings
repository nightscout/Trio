    "NSContactsUsageDescription" : {
      "comment" : "Privacy - Contacts Usage Description",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Позволява на Trio достъп до контактите Ви за актуализации на контакта на циферблата на Apple Watch чрез функцията „Contact Trick“."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umožňuje aplikaci Trio přístup k vašim kontaktům pro živé aktualizace komplikace kontaktů na Apple Watch pomocí funkce „Contact Trick“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Allows Trio to access your contacts for live updates to your Apple Watch contact complication using the 'Contact Trick' feature."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ermöglicht Trio den Zugriff auf deine Kontakte, um mit der Funktion „Kontakt Trick“ Live-Updates für die Kontakt-Komplikation auf deiner Apple Watch bereitzustellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allows Trio to access your contacts for live updates to your Apple Watch contact complication using the 'Contact Trick' feature."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Allows Trio to access your contacts for live updates to your Apple Watch contact complication using the 'Contact Trick' feature."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorise Trio à accéder à vos contacts pour les mises à jour en direct de la complication de contact sur votre Apple Watch via la fonctionnalité « Contact Trick »."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Allows Trio to access your contacts for live updates to your Apple Watch contact complication using the 'Contact Trick' feature."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consenti a Trio di accedere ai tuoi contatti per aggiornare in tempo reale la complicazione dei contatti del tuo Apple Watch sfruttando la funzione 'Contact Trick'."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio가 'Contact Trick' 기능을 사용하여 Apple Watch 연락처 컴플리케이션을 실시간으로 업데이트할 수 있도록 연락처 접근을 허용합니다."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lar Trio få tilgang til kontaktlisten for å opprette kontakter. Dette brukes til å lage live-oppdateringer til Apple Watch ved hjelp av \"kontakt-trikset\"."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geeft Trio toegang tot je contacten om via de functie ‘Contact Trick’ actuele gegevens te tonen in de contactcomplicatie op je Apple Watch."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umożliwia Trio na dostęp do kontaktów, żeby otrzymywać na bieżąco aktualizację komplikacji kontaktów na zegarku Apple Watch za pomocą funkcji „Contact Trick”."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Allows Trio to access your contacts for live updates to your Apple Watch contact complication using the 'Contact Trick' feature."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Allows Trio to access your contacts for live updates to your Apple Watch contact complication using the 'Contact Trick' feature."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Allows Trio to access your contacts for live updates to your Apple Watch contact complication using the 'Contact Trick' feature."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Allows Trio to access your contacts for live updates to your Apple Watch contact complication using the 'Contact Trick' feature."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Allows Trio to access your contacts for live updates to your Apple Watch contact complication using the 'Contact Trick' feature."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Allows Trio to access your contacts for live updates to your Apple Watch contact complication using the 'Contact Trick' feature."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cho phép Trio truy cập danh bạ của bạn để cập nhật trực tiếp vào tiện ích danh bạ trên Apple Watch bằng tính năng ‘Contact Trick’."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许 Trio 访问通讯录，使用 “Contact‑Trick 联系人技巧” 功能，实现 Apple Watch 表盘联系人组件实时刷新血糖。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允許 Trio 存取你的聯絡人，透過「Contact Trick」功能為 Apple Watch 聯絡人複雜功能提供即時更新。"
          }
        }
      }
    },
